		padding: clamp(0.65rem, 2vw, 1.5rem);
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
			linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
			rgba(255, 255, 255, 0.035);
		background-size: 22px 22px;
	}

	canvas {
		display: block;
		touch-action: none;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 2px;
		background: #050506;
		box-shadow:
			0 24px 80px rgba(0, 0, 0, 0.42),
			0 0 0 7px rgba(255, 255, 255, 0.05),
			0 0 42px rgba(33, 247, 255, 0.16);
	}

	.statusbar {
		border-top: 1px solid var(--line);
		border-bottom: 0;
		color: var(--muted);
		font-size: 0.78rem;
	}

	.inspector {
		opacity: 1;
		transition: opacity 0.18s ease;
	}

	.inspector.empty {
		opacity: 0.48;
	}

	.split,
	.position-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}

	.position-grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.position-grid input {
		padding: 0.58rem 0.45rem;
	}

	.danger {
		border-color: rgba(255, 52, 52, 0.55);
		color: #ffd0d0;
	}

	.print-spec {
		display: grid;
		gap: 0.5rem;
	}

	.print-spec div {
		display: flex;
		justify-content: space-between;
		gap: 0.6rem;
		padding: 0.62rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.055);
	}

	.print-spec span {
		color: var(--cyan);
		font-weight: 900;
	}

	@media (max-width: 1180px) {
		.workspace {
			grid-template-columns: 280px minmax(0, 1fr);
		}

		.inspector-panel {
			grid-column: 1 / -1;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.inspector-panel section {
			padding-bottom: 0;
			border-bottom: 0;
		}
	}

	@media (max-width: 860px) {
		.app-shell {
			padding: 10px;
		}

		.topbar {
			align-items: stretch;
			flex-direction: column;
		}

		.actions {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.workspace {
			grid-template-columns: 1fr;
		}

		.tools-panel {
			order: 2;
		}

		.stage-wrap {
			order: 1;
		}

		.inspector-panel {
			order: 3;
			grid-template-columns: 1fr;
		}

		.stage-toolbar,
		.statusbar {
			align-items: stretch;
			flex-direction: column;
		}

		.measure-strip {
			font-size: 0.62rem;
		}

		.compact-actions {
			display: grid;
			grid-template-columns: 1fr 1fr;
		}

		.asset-tray {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			max-height: none;
		}
	}

	@media (max-width: 520px) {
		h1 {
			font-size: 2.55rem;
		}

		.actions,
		.tool-grid,
		.theme-grid,
		.layer-actions,
		.split,
		.position-grid {
			grid-template-columns: 1fr;
		}

		.asset-tray {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.measure-strip {
			grid-template-columns: 1fr;
			text-align: left;
		}

		.measure-strip span {
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}

		.measure-strip span:last-child {
			border-bottom: 0;
		}
	}

	/* Organic 90s rework — Gremlins / Hook palette */
	:root {
		--proto-bg: #1a120a;
		--proto-panel: rgba(30, 22, 14, 0.94);
		--proto-panel-2: #1c140c;
		--proto-line: #4a3622;
		--proto-line-hot: rgba(168, 78, 38, 0.55);
		--proto-ink: #f4e8cf;
		--proto-muted: #c4ad7e;
		--proto-cyan: #7fae93;
		--proto-pink: #b03426;
		--proto-yellow: #e6b94a;
		--proto-emerald: #2d5a44;
		--proto-burgundy: #6b1f1a;
		--proto-brass: #b18a48;
		--font-display: "Bee Two", Georgia, "Times New Roman", serif;
		--font-body: Georgia, "Times New Roman", "Iowan Old Style", serif;
		--font-ui: "Oswald", "Roboto Condensed", "Archivo Black", "Helvetica Neue", Arial, sans-serif;
		font-family: var(--font-body);
		font-size: 15px;
	}

	html,
	body {
		height: 100%;
		overflow: hidden;
	}

	body {
		background:
			radial-gradient(ellipse 1100px 700px at 50% 105%, rgba(216, 168, 58, 0.18), transparent 65%),
			radial-gradient(ellipse 900px 700px at 8% 0%, rgba(45, 90, 68, 0.32), transparent 70%),
			radial-gradient(ellipse 800px 600px at 100% 0%, rgba(107, 31, 26, 0.22), transparent 68%),
			linear-gradient(180deg, #150e07 0%, #1f1610 60%, #120a05 100%);
		color: var(--proto-ink);
		user-select: none;
	}

	body::before {
		content: "";
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background-image:
			radial-gradient(rgba(74, 54, 34, 0.14) 1px, transparent 1.4px);
		background-size: 11px 11px;
		mask-image: radial-gradient(ellipse at 50% 50%, black 0%, black 60%, transparent 100%);
		opacity: 0.3;
	}

	body::after {
		content: "";
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(ellipse at 50% 50%, transparent 60%, rgba(0, 0, 0, 0.45) 100%);
	}

	.app {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-rows: auto 1fr;
		grid-template-columns: 320px minmax(0, 1fr) 360px;
		grid-template-areas:
			"top top top"
			"left main right";
		height: 100vh;
	}

	.topbar {
		grid-area: top;
		position: relative;
		z-index: 3;
		display: flex;
		align-items: center;
		gap: 20px;
		min-height: 72px;
		padding: 14px 22px;
		border: 0;
		border-bottom: 1px solid var(--proto-line);
		border-radius: 0;
		background:
			linear-gradient(180deg, #2a1d0e 0%, #1a1208 100%);
		box-shadow:
			inset 0 -1px 0 rgba(216, 168, 58, 0.2),
			0 2px 0 rgba(107, 31, 26, 0.45),
			0 6px 22px rgba(0, 0, 0, 0.65);
	}

	.brand {
		display: flex;
		align-items: baseline;
		gap: 14px;
		padding: 8px 16px 10px;
		border-radius: 3px;
		background:
			linear-gradient(180deg, #b03426 0%, #6b1f1a 100%);
		box-shadow:
			inset 0 1px 0 rgba(255, 218, 170, 0.35),
			inset 0 -1px 0 rgba(0, 0, 0, 0.55),
			0 0 0 1px rgba(20, 12, 6, 0.9),
			0 2px 6px rgba(0, 0, 0, 0.6);
		text-shadow: 0 1px 0 rgba(0, 0, 0, 0.55);
	}

	.brand__logo {
		color: #f4e3b8;
		font-family: var(--font-display);
		font-size: 28px;
		font-weight: 400;
		letter-spacing: 1px;
		line-height: 1;
	}

	.brand__sub {
		color: #f1d28a;
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.topbar__festival {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding-left: 20px;
		border-left: 1px dashed var(--proto-line-hot);
		line-height: 1.1;
	}

	.topbar__festival small {
		color: var(--proto-brass);
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.topbar__festival strong {
		color: var(--proto-yellow);
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 400;
		letter-spacing: 0.5px;
		text-shadow: 0 1px 0 rgba(0, 0, 0, 0.6);
	}

	.topbar__spacer {
		flex: 1;
	}

	.topbar__action,
	.btn,
	.file-action,
	.upload-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 44px;
		padding: 10px 16px;
		border: 1px solid var(--proto-line);
		border-radius: 3px;
		background:
			linear-gradient(180deg, #2a1f12 0%, #1a1208 100%);
		color: var(--proto-ink);
		font-family: var(--font-ui);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		text-shadow: 0 1px 0 rgba(0, 0, 0, 0.55);
		box-shadow:
			inset 0 1px 0 rgba(216, 168, 58, 0.08),
			0 1px 0 rgba(0, 0, 0, 0.55);
		transition: background 0.14s, border-color 0.14s, color 0.14s, transform 0.14s;
	}

	.topbar__action:hover,
	.btn:hover,
	.file-action:hover,
	.upload-button:hover {
		border-color: var(--proto-brass);
		background: linear-gradient(180deg, #3a2a18 0%, #221708 100%);
		color: #fbeac4;
	}

	.topbar__action--primary,
	.btn--neon {
		border-color: #6b4a18;
		background:
			linear-gradient(180deg, #e6b94a 0%, #8a5a18 100%);
		color: #1f0f02;
		font-family: var(--font-ui);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 1.2px;
		text-shadow: 0 1px 0 rgba(255, 230, 170, 0.55);
		box-shadow:
			inset 0 1px 0 rgba(255, 230, 170, 0.55),
			inset 0 -1px 0 rgba(60, 30, 0, 0.45),
			0 0 0 1px rgba(20, 12, 6, 0.85),
			0 2px 8px rgba(0, 0, 0, 0.5);
	}

	.topbar__action--primary:hover,
	.btn--neon:hover {
		color: #1f0f02;
		background:
			linear-gradient(180deg, #e6b94a 0%, #9a6a20 100%);
		border-color: #6b4a18;
	}

	.topbar__action--secondary {
		background: linear-gradient(180deg, #221808 0%, #150d05 100%);
	}

	.btn--ghost {
		border-style: dashed;
		background: transparent;
		box-shadow: none;
	}

	.btn--danger {
		color: #d97a5a;
		border-color: rgba(176, 52, 38, 0.55);
	}

	.file-action input,
	.upload-button input,
	.guide-toggle input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}

	.rail {
		position: relative;
		z-index: 2;
		overflow-y: auto;
		background:
			linear-gradient(180deg, rgba(32, 22, 12, 0.96) 0%, rgba(18, 12, 6, 0.96) 100%);
		backdrop-filter: blur(6px);
		scrollbar-color: var(--proto-brass) #1c140c;
		scrollbar-width: thin;
	}

	.rail--left {
		grid-area: left;
		border-right: 1px solid var(--proto-line);
		box-shadow: inset -1px 0 0 rgba(216, 168, 58, 0.06);
	}

	.rail--right {
		grid-area: right;
		border-left: 1px solid var(--proto-line);
		box-shadow: inset 1px 0 0 rgba(216, 168, 58, 0.06);
	}

	.section {
		padding: 18px 20px;
		border-bottom: 1px dashed var(--proto-line);
	}

	.section__head {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 14px;
	}

	.section__dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--proto-burgundy);
		box-shadow:
			inset 0 1px 0 rgba(255, 180, 140, 0.4),
			0 0 0 1px rgba(20, 12, 6, 0.8),
			0 0 10px rgba(176, 52, 38, 0.45);
		animation: pulse 2.4s ease-in-out infinite;
	}

	.section__title {
		color: var(--proto-yellow);
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 400;
		letter-spacing: 0.5px;
		text-shadow: 0 1px 0 rgba(0, 0, 0, 0.6);
		text-transform: uppercase;
	}

	.themes,
	.layouts,
	.tool-grid,
	.layer-actions {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
	}

	.segment {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 6px;
	}

	.segment button,
	.theme,
	.layout,
	.asset {
		border-radius: 3px;
	}

	.segment button.active {
		border-color: var(--proto-yellow);
		background: linear-gradient(180deg, #3a2a14 0%, #2a1d0a 100%);
		color: var(--proto-yellow);
		box-shadow:
			inset 0 1px 0 rgba(216, 168, 58, 0.25),
			0 0 10px rgba(216, 168, 58, 0.25);
	}

	.theme,
	.layout {
		position: relative;
		overflow: hidden;
		padding: 0;
		border: 2px solid var(--proto-line);
		background: #0d0905;
		cursor: pointer;
		box-shadow:
			inset 0 0 0 1px rgba(0, 0, 0, 0.6),
			0 1px 2px rgba(0, 0, 0, 0.6);
		transition: border-color 0.14s, transform 0.14s, box-shadow 0.14s;
	}

	.theme {
		aspect-ratio: 1.2 / 1;
	}

	.layout {
		aspect-ratio: 0.7 / 1;
		background: #1c140c;
	}

	.theme:hover,
	.layout:hover {
		transform: translateY(-1px);
		border-color: var(--proto-brass);
	}

	.theme[data-active="true"],
	.layout[data-active="true"] {
		border-color: var(--proto-yellow);
		box-shadow:
			inset 0 0 0 1px rgba(0, 0, 0, 0.7),
			0 0 0 1px rgba(216, 168, 58, 0.5),
			0 0 16px rgba(216, 168, 58, 0.35);
	}

	.theme__preview,
	.layout__preview {
		position: absolute;
		inset: 0;
	}

	.theme__preview::before,
	.layout__preview::before,
	.layout__preview::after {
		content: "";
		position: absolute;
	}

	.theme__preview--neon {
		background:
			radial-gradient(circle at 50% 58%, #ffd84a 0 18%, #ff5d4a 19% 30%, transparent 31%),
			linear-gradient(180deg, #1b0540 0%, #b91776 56%, #ffb04a 100%);
	}

	.theme__preview--rental {
		background:
			radial-gradient(circle at 75% 20%, #d23218 0 14%, transparent 15%),
			linear-gradient(170deg, #f4e3b6 0%, #c8a05a 100%);
	}

	.theme__preview--scifi {
		background:
			radial-gradient(circle at 72% 26%, #ffe89a 0 10%, #ff8a3a 11% 22%, transparent 23%),
			linear-gradient(165deg, #02030c 0%, #0a1238 38%, #5e1a78 100%);
	}

	.theme__preview--horror {
		background:
			radial-gradient(circle at 50% 30%, #3a0a08 0 22%, transparent 45%),
			linear-gradient(175deg, #0a0102 0%, #3a0a08 70%, #0a0102 100%);
	}

	.theme__label,
	.layout__name {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		padding: 6px 8px;
		background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.88) 60%);
		color: #f4e8cf;
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 1px;
		text-align: center;
		text-shadow: 0 1px 2px #000;
		text-transform: uppercase;
	}

	@keyframes pulse {
		0%, 100% {
			opacity: 1;
			box-shadow:
				inset 0 1px 0 rgba(255, 180, 140, 0.4),
				0 0 0 1px rgba(20, 12, 6, 0.8),
				0 0 8px rgba(176, 52, 38, 0.35);
		}
		50% {
			opacity: 0.85;
			box-shadow:
				inset 0 1px 0 rgba(255, 180, 140, 0.6),
				0 0 0 1px rgba(20, 12, 6, 0.8),
				0 0 14px rgba(176, 52, 38, 0.65);
		}
	}

	.layout__preview--classic::before {
		inset: 8px 10px auto;
		height: 54%;
		background: #3a1f5e;
	}

	.layout__preview--classic::after {
		right: 10px;
		bottom: 30px;
		left: 10px;
		height: 18px;
		background: var(--proto-yellow);
	}

	.layout__preview--bigtype::before {
		inset: 8px;
		background: #3a1f5e;
	}

	.layout__preview--bigtype::after {
		right: 8px;
		bottom: 8px;
		left: 8px;
		height: 40%;
		background: linear-gradient(180deg, transparent, #000d);
	}

	.layout__preview--poster {
		background: linear-gradient(135deg, var(--proto-pink), var(--proto-cyan));
	}

	.layout__preview--poster::after {
		right: 8px;
		top: 10px;
		left: 8px;
		height: 16px;
		background: var(--proto-yellow);
	}

	.layout__preview--split::before {
		inset: 0 0 auto;
		height: 48%;
		background: var(--proto-pink);
	}

	.layout__preview--split::after {
		right: 8px;
		top: 58%;
		left: 8px;
		height: 28px;
		background: var(--proto-yellow);
	}

	.asset-tray {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 6px;
		max-height: 330px;
		overflow: auto;
		padding-right: 3px;
	}

	.asset {
		display: grid;
		grid-template-rows: 56px auto;
		gap: 6px;
		align-items: center;
		justify-items: center;
		min-height: 92px;
		padding: 8px;
		background:
			linear-gradient(180deg, #1f1610 0%, #150e07 100%);
		border: 1px solid var(--proto-line);
		color: var(--proto-ink);
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: 0.4px;
		box-shadow: inset 0 1px 0 rgba(216, 168, 58, 0.06);
	}

	.asset img {
		max-width: 100%;
		max-height: 56px;
		object-fit: contain;
		filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
	}

	.asset span {
		width: 100%;
		overflow: hidden;
		text-align: center;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.asset-count {
		display: block;
		margin-top: 10px;
		color: var(--proto-muted);
		font-family: var(--font-body);
		font-size: 12px;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.stage-shell {
		grid-area: main;
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 0;
		min-width: 0;
		overflow: hidden;
		padding: 18px 24px 14px;
	}

	.stage__topbar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 12px;
		padding: 0 4px;
	}

	.stage__topbar .segment {
		flex: 0 0 auto;
		display: inline-flex;
		gap: 0;
		padding: 4px;
		border: 1px solid var(--proto-line);
		border-radius: 4px;
		background: linear-gradient(180deg, #221808 0%, #150d05 100%);
		box-shadow: inset 0 1px 0 rgba(216, 168, 58, 0.06);
	}

	.stage__topbar .segment button {
		min-height: 36px;
		padding: 6px 18px;
		border: 0;
		border-radius: 3px;
		background: transparent;
		color: var(--proto-muted);
		font-family: var(--font-ui);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		text-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
		box-shadow: none;
	}

	.stage__topbar .segment button:hover {
		color: var(--proto-ink);
		background: rgba(216, 168, 58, 0.06);
	}

	.stage__topbar .segment button.active {
		background: linear-gradient(180deg, #3a2a14 0%, #2a1d0a 100%);
		color: var(--proto-yellow);
		border-color: transparent;
		box-shadow:
			inset 0 1px 0 rgba(216, 168, 58, 0.3),
			0 0 10px rgba(216, 168, 58, 0.18);
	}

	.stage__hint {
		flex: 1 1 auto;
		padding: 8px 14px;
		border: 1px dashed var(--proto-line);
		border-radius: 3px;
		background: rgba(20, 12, 6, 0.7);
		color: var(--proto-muted);
		font-family: var(--font-body);
		font-size: 13px;
		font-style: italic;
		letter-spacing: 0.3px;
		text-align: center;
		pointer-events: none;
	}

	.stage__zoom {
		position: absolute;
		right: 28px;
		bottom: 64px;
		z-index: 5;
		display: flex;
