---
import InspectorRail from "../components/InspectorRail.astro";
import Stage from "../components/Stage.astro";
import ToolsRail from "../components/ToolsRail.astro";
import Topbar from "../components/Topbar.astro";
import TourOverlay from "../components/TourOverlay.astro";
import "../styles/editor.css";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>VHS Studio - Jaquette imprimable</title>
	</head>
	<body>
		<div class="app">
			<Topbar />
			<div class="mobile-backdrop" id="mobileBackdrop" aria-hidden="true"></div>
			<ToolsRail />
			<Stage />
			<InspectorRail />
			<TourOverlay />
			<div class="ui-tooltip" id="uiTooltip" role="tooltip" hidden></div>
		</div>
	</body>
</html>

<script>
	import { Editor } from "../lib/editor/Editor";
	new Editor().init();
</script>
