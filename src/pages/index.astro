	function projectSnapshot() {
		return {
			name: project.name,
			background: project.background,
			objects: structuredClone(project.objects),
			activeTheme,
			activeLayout,
			showGuides,
		};
	}

	function restoreProjectSnapshot(snapshot) {
		project.name = snapshot.name || project.name;
		project.background = snapshot.background || project.background;
		project.objects = structuredClone(snapshot.objects || project.objects);
		activeTheme = snapshot.activeTheme || activeTheme;
		activeLayout = snapshot.activeLayout || activeLayout;
		showGuides = snapshot.showGuides ?? showGuides;
		toggleGuides.checked = showGuides;
		project.objects.filter((object) => object.type === "image").forEach((object) => void loadImage(object.src).catch(() => null));
		document.querySelectorAll("[data-theme]").forEach((button) => {
			button.dataset.active = String(button.dataset.theme === activeTheme);
		});
		document.querySelectorAll("[data-layout]").forEach((button) => {
			button.dataset.active = String(button.dataset.layout === activeLayout);
		});
		selectObject(null);
		updateHistoryButtons();
		scheduleRender();
	}

	function updateHistoryButtons() {
		for (const button of [undoAction, undoActionStage]) button.disabled = historyPast.length === 0;
		for (const button of [redoAction, redoActionStage]) button.disabled = historyFuture.length === 0;
	}

	function applyTooltipLabels() {
		for (const [id, help] of Object.entries(HELP_TEXT)) {
			document.querySelector(`#${id}`)?.setAttribute("data-help", help);
		}
		document.querySelector("#loadProject")?.closest("label")?.setAttribute("data-help", "Charge un projet VHS Studio sauvegardé.");
		toggleGuides.closest("label")?.setAttribute("data-help", "Affiche ou masque les repères d'impression.");
		quickColor.closest("label")?.setAttribute("data-help", "Change la couleur de l'élément sélectionné.");
		document.querySelectorAll("[data-theme]").forEach((button) => {
			button.dataset.help = THEME_HELP[button.dataset.theme] || "Change le thème visuel.";
		});
		document.querySelectorAll("[data-layout]").forEach((button) => {
			button.dataset.help = LAYOUT_HELP[button.dataset.layout] || "Change la mise en page du recto.";
		});
		document.querySelectorAll("[data-zone]").forEach((button) => {
			button.dataset.help = ZONE_HELP[button.dataset.zone] || "Choisit la zone active.";
		});
	}

	function tooltipTarget(target) {
		return target.closest("[data-help], button[title], label[title], .asset[title], .rating[title]");
	}

	function tooltipText(element) {
		return element?.dataset?.help || element?.getAttribute("title") || element?.getAttribute("aria-label") || element?.textContent?.trim() || "";
	}

	function showTooltip(event) {
		const target = tooltipTarget(event.target);
		const textValue = tooltipText(target);
		if (!target || !textValue || target.disabled || tourOverlay.hidden === false) return;
		tooltipAnchor = target;
		uiTooltip.textContent = textValue;
		uiTooltip.hidden = false;
		positionTooltip(event);
	}

	function positionTooltip(event = null) {
		if (!tooltipAnchor || uiTooltip.hidden) return;
		const rect = tooltipAnchor.getBoundingClientRect();
		const tooltipRect = uiTooltip.getBoundingClientRect();
		const fromPointer = event?.clientX && event?.clientY;
		const anchorX = fromPointer ? event.clientX : rect.left + rect.width / 2;
		const anchorY = fromPointer ? event.clientY : rect.top;
		const left = clamp(anchorX - tooltipRect.width / 2, 10, window.innerWidth - tooltipRect.width - 10);
		const aboveTop = anchorY - tooltipRect.height - 14;
		const belowTop = rect.bottom + 12;
		const top = aboveTop > 10 ? aboveTop : Math.min(window.innerHeight - tooltipRect.height - 10, belowTop);
		uiTooltip.style.left = `${left}px`;
		uiTooltip.style.top = `${top}px`;
	}

	function hideTooltip() {
		tooltipAnchor = null;
		uiTooltip.hidden = true;
	}

	function wireTooltips() {
		applyTooltipLabels();
		document.addEventListener("pointerover", showTooltip);
		document.addEventListener("pointermove", positionTooltip);
		document.addEventListener("pointerout", (event) => {
			if (tooltipAnchor && !event.relatedTarget?.closest?.("[data-help], button[title], label[title], .asset[title], .rating[title]")) hideTooltip();
		});
		document.addEventListener("mouseover", showTooltip);
		document.addEventListener("mousemove", positionTooltip);
		document.addEventListener("mouseout", (event) => {
			if (tooltipAnchor && !event.relatedTarget?.closest?.("[data-help], button[title], label[title], .asset[title], .rating[title]")) hideTooltip();
		});
		document.addEventListener("focusin", showTooltip);
		document.addEventListener("focusout", hideTooltip);
		window.addEventListener("scroll", hideTooltip, true);
		window.addEventListener("resize", hideTooltip);
	}

	function pushHistory() {
		historyPast.push(projectSnapshot());
		if (historyPast.length > HISTORY_LIMIT) historyPast.shift();
		historyFuture.length = 0;
		updateHistoryButtons();
	}

	function undoProject() {
		if (!historyPast.length) return;
		historyFuture.unshift(projectSnapshot());
		restoreProjectSnapshot(historyPast.pop());
		setStatus("Modification annulée.");
	}

	function redoProject() {
		if (!historyFuture.length) return;
		historyPast.push(projectSnapshot());
		restoreProjectSnapshot(historyFuture.shift());
		setStatus("Modification rétablie.");
	}

	function makeId() {
		return `layer-${Math.random().toString(36).slice(2, 9)}`;
	}

	function rect(name, x, y, w, h, fill, locked = false) {
		return { id: makeId(), type: "rect", name, x, y, w, h, fill, stroke: "transparent", opacity: 1, rotation: 0, locked };
	}

	function text(name, content, x, y, w, h, fontSize, fill, align, fontFamily, rotation = 0) {
		return { id: makeId(), type: "text", name, content, x, y, w, h, fontSize, fill, align, fontFamily, opacity: 1, rotation, locked: false, shadow: "" };
	}

	function image(name, src, x, y, w, h) {
		void loadImage(src);
		return { id: makeId(), type: "image", name, src, x, y, w, h, opacity: 1, rotation: 0, fit: "contain", locked: false };
	}

	function zoneCenter(zoneName, size) {
		const zone = ZONES[zoneName];
		return {
			x: zone.x + (zone.w - size.w) / 2,
			y: zone.y + (zone.h - size.h) / 2,
		};
	}

	function scheduleRender() {
		if (raf) return;
		raf = requestAnimationFrame(() => {
			raf = 0;
			render();
		});
	}

	function setupCanvasSize() {
		const box = stageScroller.getBoundingClientRect();
		const isMobile = window.matchMedia("(max-width: 900px)").matches;
		const cssW = Math.min(Math.max(240, box.width - (isMobile ? 18 : 0)), 1180);
		const cssH = cssW * (COVER.h / COVER.w);
		const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
		canvas.style.width = `${cssW}px`;
		canvas.style.height = `${cssH}px`;
		canvas.width = Math.round(cssW * dpr);
		canvas.height = Math.round(cssH * dpr);
		currentScale = canvas.width / COVER.w;
		render();
		updateCanvasDeleteButton();
		updateSelectionToolbar();
	}

	function render(targetCanvas = canvas, opts = {}) {
		const targetCtx = targetCanvas.getContext("2d");
		const scale = targetCanvas.width / COVER.w;
		targetCtx.clearRect(0, 0, targetCanvas.width, targetCanvas.height);
		drawBackdrop(targetCtx, scale);
		for (const object of project.objects) drawObject(targetCtx, object, scale);
		if (opts.guides !== false && showGuides) drawGuides(targetCtx, scale);
		if (targetCanvas === canvas && selectedId) drawSelection(targetCtx, getSelected(), scale);
	}

	function drawBackdrop(targetCtx, scale) {
		targetCtx.save();
		targetCtx.fillStyle = project.background;
		targetCtx.fillRect(0, 0, COVER.w * scale, COVER.h * scale);
		targetCtx.globalAlpha = 0.16;
		for (let y = 0; y < COVER.h; y += 2.2) {
			targetCtx.fillStyle = y % 4.4 < 2.2 ? "#ffffff" : "#000000";
			targetCtx.fillRect(0, y * scale, COVER.w * scale, 0.45 * scale);
		}
		targetCtx.restore();
	}

	function drawObject(targetCtx, object, scale) {
		targetCtx.save();
		targetCtx.globalAlpha = object.opacity ?? 1;
		const cx = (object.x + object.w / 2) * scale;
		const cy = (object.y + object.h / 2) * scale;
		targetCtx.translate(cx, cy);
		targetCtx.rotate(((object.rotation || 0) * Math.PI) / 180);
		targetCtx.translate((-object.w * scale) / 2, (-object.h * scale) / 2);

		if (object.type === "rect") {
			targetCtx.fillStyle = object.fill;
			targetCtx.fillRect(0, 0, object.w * scale, object.h * scale);
			if (object.stroke && object.stroke !== "transparent") {
				targetCtx.strokeStyle = object.stroke;
				targetCtx.lineWidth = Math.max(1, 0.4 * scale);
				targetCtx.strokeRect(0, 0, object.w * scale, object.h * scale);
			}
		}

		if (object.type === "image") {
			const img = imageCache.get(object.src);
			if (img?.complete) {
				drawFittedImage(targetCtx, img, object.w * scale, object.h * scale, object.fit || "contain");
			} else {
				targetCtx.fillStyle = "#111";
				targetCtx.fillRect(0, 0, object.w * scale, object.h * scale);
				targetCtx.strokeStyle = "#ff2dd4";
				targetCtx.strokeRect(0, 0, object.w * scale, object.h * scale);
			}
		}

		if (object.type === "text") {
			drawText(targetCtx, object, scale);
		}
		targetCtx.restore();
	}

	function drawFittedImage(targetCtx, img, w, h, fit) {
		const imageRatio = img.naturalWidth / img.naturalHeight;
		const boxRatio = w / h;
		let dw = w;
		let dh = h;
		let dx = 0;
		let dy = 0;
		if (fit === "cover" ? imageRatio > boxRatio : imageRatio < boxRatio) {
			dh = fit === "cover" ? h : w / imageRatio;
			dw = fit === "cover" ? h * imageRatio : w;
			dx = (w - dw) / 2;
			dy = (h - dh) / 2;
		} else {
			dw = fit === "cover" ? w : h * imageRatio;
			dh = fit === "cover" ? w / imageRatio : h;
			dx = (w - dw) / 2;
			dy = (h - dh) / 2;
		}
		targetCtx.drawImage(img, dx, dy, dw, dh);
	}

	function drawText(targetCtx, object, scale) {
		const size = object.fontSize * scale;
		const lineHeight = size * 1.08;
		targetCtx.fillStyle = object.fill;
		targetCtx.font = `900 ${size}px ${object.fontFamily}`;
		targetCtx.textAlign = object.align || "left";
		targetCtx.textBaseline = "top";
		if (object.shadow) {
			targetCtx.shadowColor = object.shadow;
			targetCtx.shadowBlur = 2.2 * scale;
			targetCtx.shadowOffsetX = 1.2 * scale;
			targetCtx.shadowOffsetY = 1.2 * scale;
		}
		const maxWidth = object.w * scale;
		const x = object.align === "center" ? maxWidth / 2 : object.align === "right" ? maxWidth : 0;
		const lines = wrapText(targetCtx, object.content || "", maxWidth);
		lines.slice(0, Math.max(1, Math.ceil((object.h * scale) / lineHeight))).forEach((line, index) => {
			targetCtx.fillText(line, x, index * lineHeight);
		});
	}

	function wrapText(targetCtx, textValue, maxWidth) {
		const hardLines = String(textValue).split("\n");
		const lines = [];
		for (const hardLine of hardLines) {
			const words = hardLine.split(/\s+/).filter(Boolean);
			if (!words.length) {
				lines.push("");
				continue;
			}
			let line = "";
			for (const word of words) {
				const next = line ? `${line} ${word}` : word;
				if (targetCtx.measureText(next).width <= maxWidth || !line) {
					line = next;
				} else {
					lines.push(line);
					line = word;
				}
			}
			lines.push(line);
		}
		return lines;
	}

	function drawGuides(targetCtx, scale) {
		targetCtx.save();
		targetCtx.strokeStyle = "#ff3434";
		targetCtx.lineWidth = Math.max(1, 0.35 * scale);
		targetCtx.strokeRect(0.4 * scale, 0.4 * scale, (COVER.w - 0.8) * scale, (COVER.h - 0.8) * scale);
		targetCtx.setLineDash([4 * scale, 2.5 * scale]);
		targetCtx.strokeStyle = "rgba(255,255,255,0.62)";
		targetCtx.beginPath();
		targetCtx.moveTo(ZONES.spine.x * scale, 0);
		targetCtx.lineTo(ZONES.spine.x * scale, COVER.h * scale);
		targetCtx.moveTo((ZONES.spine.x + ZONES.spine.w) * scale, 0);
		targetCtx.lineTo((ZONES.spine.x + ZONES.spine.w) * scale, COVER.h * scale);
		targetCtx.stroke();
		targetCtx.setLineDash([]);
		targetCtx.fillStyle = "rgba(255,255,255,0.84)";
		targetCtx.font = `700 ${Math.max(9, 2.8 * scale)}px Arial`;
		targetCtx.fillText("VERSO", 3 * scale, 5 * scale);
		targetCtx.fillText("TRANCHE", 116 * scale, 5 * scale);
		targetCtx.fillText("RECTO", 147 * scale, 5 * scale);
		targetCtx.restore();
	}

	function drawSelection(targetCtx, object, scale) {
		if (!object) return;
		const cx = (object.x + object.w / 2) * scale;
		const cy = (object.y + object.h / 2) * scale;
		targetCtx.save();
		targetCtx.translate(cx, cy);
		targetCtx.rotate(degToRad(object.rotation || 0));
		targetCtx.translate((-object.w * scale) / 2, (-object.h * scale) / 2);
		targetCtx.strokeStyle = "#fff365";
		targetCtx.lineWidth = Math.max(1.5, 0.45 * scale);
		targetCtx.setLineDash([5, 4]);
		targetCtx.strokeRect(0, 0, object.w * scale, object.h * scale);
		targetCtx.setLineDash([]);
		targetCtx.restore();

		const handles = getHandles(object);
		const top = handles.find((handle) => handle.name === "n");
		const rotate = handles.find((handle) => handle.name === "rotate");
		targetCtx.save();
		targetCtx.lineWidth = 2;
		targetCtx.strokeStyle = "#fff365";
		targetCtx.beginPath();
		targetCtx.moveTo(top.x * scale, top.y * scale);
		targetCtx.lineTo(rotate.x * scale, rotate.y * scale);
		targetCtx.stroke();
		for (const handle of handles) {
			targetCtx.fillStyle = handle.type === "rotate" ? "#fff365" : "#0c0614";
			targetCtx.strokeStyle = handle.type === "rotate" ? "#160b22" : "#21f7ff";
			targetCtx.lineWidth = 2;
			targetCtx.beginPath();
			if (handle.type === "rotate") {
				targetCtx.arc(handle.x * scale, handle.y * scale, 7, 0, Math.PI * 2);
			} else {
				targetCtx.rect(handle.x * scale - 6, handle.y * scale - 6, 12, 12);
			}
			targetCtx.fill();
			targetCtx.stroke();
		}
		targetCtx.restore();
	}

	function getHandles(object) {
		const locals = [
			{ name: "nw", x: 0, y: 0, type: "resize", cursor: "nwse-resize" },
			{ name: "n", x: object.w / 2, y: 0, type: "resize", cursor: "ns-resize" },
			{ name: "ne", x: object.w, y: 0, type: "resize", cursor: "nesw-resize" },
			{ name: "e", x: object.w, y: object.h / 2, type: "resize", cursor: "ew-resize" },
			{ name: "se", x: object.w, y: object.h, type: "resize", cursor: "nwse-resize" },
			{ name: "s", x: object.w / 2, y: object.h, type: "resize", cursor: "ns-resize" },
			{ name: "sw", x: 0, y: object.h, type: "resize", cursor: "nesw-resize" },
			{ name: "w", x: 0, y: object.h / 2, type: "resize", cursor: "ew-resize" },
			{ name: "rotate", x: object.w / 2, y: -14, type: "rotate", cursor: "grab" },
		];
		return locals.map((handle) => ({ ...handle, ...localToWorld(object, handle) }));
	}

	function loadImage(src) {
		if (imageCache.has(src)) return Promise.resolve(imageCache.get(src));
		if (imagePromises.has(src)) return imagePromises.get(src);
		const promise = new Promise((resolve, reject) => {
			const img = new Image();
			img.onload = () => {
				imageCache.set(src, img);
				imagePromises.delete(src);
				scheduleRender();
				resolve(img);
			};
			img.onerror = () => {
				imagePromises.delete(src);
				reject(new Error(`Unable to load image: ${src}`));
			};
			img.src = src;
		});
		imagePromises.set(src, promise);
		return promise;
	}

	function canvasPoint(event) {
		const rect = canvas.getBoundingClientRect();
		return {
			x: ((event.clientX - rect.left) / rect.width) * COVER.w,
			y: ((event.clientY - rect.top) / rect.height) * COVER.h,
		};
	}

	function degToRad(degrees) {
		return (degrees * Math.PI) / 180;
	}

	function radToDeg(radians) {
		return (radians * 180) / Math.PI;
	}

	function normalizeAngle(degrees) {
		let angle = ((degrees + 180) % 360) - 180;
		if (angle < -180) angle += 360;
		return angle;
	}

	function rotatePoint(point, angle) {
		const cos = Math.cos(angle);
		const sin = Math.sin(angle);
		return {
			x: point.x * cos - point.y * sin,
			y: point.x * sin + point.y * cos,
		};
	}

	function objectCenter(object) {
		return { x: object.x + object.w / 2, y: object.y + object.h / 2 };
	}

	function localToWorld(object, local) {
		const center = objectCenter(object);
		const rotated = rotatePoint({ x: local.x - object.w / 2, y: local.y - object.h / 2 }, degToRad(object.rotation || 0));
		return { x: center.x + rotated.x, y: center.y + rotated.y };
	}

	function worldToLocal(point, object) {
		const center = objectCenter(object);
		const rotated = rotatePoint({ x: point.x - center.x, y: point.y - center.y }, -degToRad(object.rotation || 0));
		return { x: rotated.x + object.w / 2, y: rotated.y + object.h / 2 };
	}

	function hitTest(point) {
		for (let i = project.objects.length - 1; i >= 0; i--) {
			const object = project.objects[i];
			if (object.locked) continue;
			const local = worldToLocal(point, object);
			if (local.x >= 0 && local.x <= object.w && local.y >= 0 && local.y <= object.h) return object;
		}
		return null;
	}

	function hitHandle(point) {
		const selected = getSelected();
		if (!selected) return null;
		const threshold = 13 / currentScale;
		return getHandles(selected).find((handle) => Math.hypot(point.x - handle.x, point.y - handle.y) < threshold);
	}

	function getSelected() {
		return project.objects.find((object) => object.id === selectedId) || null;
	}

	function selectObject(id) {
		if (id !== selectedId) resetCanvasDeleteConfirm();
		selectedId = id;
		updateInspector();
		updateCanvasDeleteButton();
		updateSelectionToolbar();
		scheduleRender();
	}

	function openInspectorDrawerIfMobile() {
		if (!window.matchMedia("(max-width: 900px)").matches) return;
		if (document.body.classList.contains("is-inspector-open")) return;
		document.querySelector("#toggleInspectorRail")?.click();
	}

	function resetCanvasDeleteConfirm() {
		if (canvasDeleteConfirmTimer) {
			clearTimeout(canvasDeleteConfirmTimer);
			canvasDeleteConfirmTimer = 0;
		}
		canvasDelete.dataset.confirming = "false";
	}

	function updateCanvasDeleteButton() {
		canvasDelete.hidden = true;
		resetCanvasDeleteConfirm();
	}

	function updateSelectionToolbar() {
		const object = getSelected();
		if (!object || object.locked) {
			selectionToolbar.hidden = true;
			return;
		}
		const stage = canvas.parentElement;
		if (!stage) return;
		const stageRect = stage.getBoundingClientRect();
		const canvasRect = canvas.getBoundingClientRect();
		if (!canvasRect.width) return;
		const offsetLeft = canvasRect.left - stageRect.left;
		const offsetTop = canvasRect.top - stageRect.top;
		const scale = canvasRect.width / COVER.w;
		const topCenter = localToWorld(object, { x: object.w / 2, y: 0 });
		const left = topCenter.x * scale + offsetLeft;
		const top = topCenter.y * scale + offsetTop;
		selectionToolbar.hidden = false;
		selectionToolbar.dataset.kind = object.type;
		selectionToolbar.style.left = `${left}px`;
		selectionToolbar.style.top = `${top}px`;
		quickColor.value = object.fill || "#ffffff";
		quickFit.textContent = object.fit === "cover" ? "□" : "⛶";
	}

	function selectTitleForTour() {
		const title = project.objects
			.slice()
			.reverse()
			.find((object) => object.type === "text" && object.name === "Titre" && object.x >= ZONES.front.x);
		if (title) selectObject(title.id);
	}

	function startTourAt(index = 0) {
		hideTooltip();
		activeTourIndex = clamp(index, 0, TOUR_STEPS.length - 1);
		tourOverlay.hidden = false;
		document.body.classList.add("is-tour-open");
		renderTourStep();
	}

	function closeTour() {
		activeTourIndex = -1;
		tourOverlay.hidden = true;
		document.body.classList.remove("is-tour-open");
	}

	function nextTourStep() {
		if (activeTourIndex >= TOUR_STEPS.length - 1) {
			closeTour();
			return;
		}
		activeTourIndex += 1;
		renderTourStep();
	}

	function previousTourStep() {
		if (activeTourIndex <= 0) return;
		activeTourIndex -= 1;
		renderTourStep();
	}

	function renderTourStep() {
		const step = TOUR_STEPS[activeTourIndex];
		if (!step) return;
		step.prepare?.();
		tourMeta.textContent = `Étape ${activeTourIndex + 1} / ${TOUR_STEPS.length}`;
		tourTitle.textContent = step.title;
		tourBody.textContent = step.body;
		tourPrev.disabled = activeTourIndex === 0;
		tourNext.textContent = activeTourIndex === TOUR_STEPS.length - 1 ? "Terminer" : "Suivant";
		requestAnimationFrame(positionTourStep);
	}

	function positionTourStep() {
		if (activeTourIndex < 0 || tourOverlay.hidden) return;
		const step = TOUR_STEPS[activeTourIndex];
		const target = step?.target?.();
		const rect = target?.getBoundingClientRect?.();
		const fallback = canvas.getBoundingClientRect();
		const box = rect && rect.width > 0 && rect.height > 0 ? rect : fallback;
		const pad = 10;
		const left = Math.max(8, box.left - pad);
		const top = Math.max(8, box.top - pad);
		const width = Math.min(window.innerWidth - left - 8, box.width + pad * 2);
		const height = Math.min(window.innerHeight - top - 8, box.height + pad * 2);

		tourSpotlight.style.left = `${left}px`;
		tourSpotlight.style.top = `${top}px`;
		tourSpotlight.style.width = `${width}px`;
		tourSpotlight.style.height = `${height}px`;

		const cardRect = tourCard.getBoundingClientRect();
		const preferredBelow = top + height + 14;
		const preferredAbove = top - cardRect.height - 14;
		const cardTop = preferredBelow + cardRect.height < window.innerHeight - 10 ? preferredBelow : Math.max(10, preferredAbove);
		const cardLeft = clamp(left + width / 2 - cardRect.width / 2, 10, window.innerWidth - cardRect.width - 10);
		tourCard.style.left = `${cardLeft}px`;
		tourCard.style.top = `${cardTop}px`;
	}

	function onCanvasDeleteClick(event) {
		event.stopPropagation();
		const object = getSelected();
		if (!object || object.locked) return;
		if (canvasDelete.dataset.confirming === "true") {
			resetCanvasDeleteConfirm();
			deleteSelected();
			return;
		}
		canvasDelete.dataset.confirming = "true";
		if (canvasDeleteConfirmTimer) clearTimeout(canvasDeleteConfirmTimer);
		canvasDeleteConfirmTimer = setTimeout(() => {
			resetCanvasDeleteConfirm();
		}, 3500);
	}

	function updateInspector() {
		const object = getSelected();
		selectedLabel.textContent = object ? object.name : "aucun";
		inspector.classList.toggle("empty", !object);
		const textControls = [textContent, fontFamily, fontSize, textAlign];
		textControls.forEach((control) => {
			control.disabled = !object || object.type !== "text";
		});
		imageFit.disabled = !object || object.type !== "image";
		const replaceDisabled = !object || object.type !== "image";
		replaceImage.disabled = replaceDisabled;
		replaceImageInput.disabled = replaceDisabled;
		replaceImage.setAttribute("aria-disabled", replaceDisabled ? "true" : "false");
		if (!object) return;
		textContent.value = object.type === "text" ? object.content : "";
		fontFamily.value = object.fontFamily || "Arial, sans-serif";
		fontSize.value = object.fontSize || 8;
		fillColor.value = object.fill || "#ffffff";
		opacity.value = object.opacity ?? 1;
		rotation.value = object.rotation || 0;
		textAlign.value = object.align || "left";
		imageFit.value = object.fit || "contain";
		posX.value = Math.round(object.x);
		posY.value = Math.round(object.y);
		posW.value = Math.round(object.w);
		posH.value = Math.round(object.h);
	}

	function updateSelected(mutator) {
		const object = getSelected();
		if (!object) return;
		mutator(object);
		updateInspector();
		updateSelectionToolbar();
		scheduleRender();
	}

	function addObject(object) {
		pushHistory();
		project.objects.push(object);
		selectObject(object.id);
		setStatus(`${object.name} ajouté.`);
	}

	function addTextLayer(kind) {
		const t = THEMES[activeTheme];
		const size = kind === "title" ? { w: 88, h: 26 } : { w: 86, h: 36 };
		const pos = zoneCenter(activeZone, size);
		const layer = text(
