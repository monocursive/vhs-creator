<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>VHS Studio - Jaquette imprimable</title>
	</head>
	<body>
		<div class="app">
			<header class="topbar">
				<div class="brand" aria-label="VHS Studio">
					<span class="brand__logo">VHS STUDIO</span>
					<span class="brand__sub">REC ●</span>
				</div>
				<a
					class="topbar__festival"
					id="contestLink"
					href="https://boskop.org/appel-a-jaquettes-vhs-2026/"
					target="_blank"
					rel="noopener noreferrer"
				>
					<small>Concours 2026</small>
					<strong>CONTRE-FICTIONS · BOSKOP · LES INTERGALACTIQUES</strong>
					<span class="topbar__festival-action">Déposer sa jaquette ↗</span>
				</a>
				<div class="topbar__spacer"></div>
				<div class="topbar__actions" id="topbarActions">
					<button class="topbar__action topbar__action--secondary history-action" id="undoAction" type="button" title="Annuler (⌘Z)" disabled>↶ Annuler</button>
					<button class="topbar__action topbar__action--secondary history-action" id="redoAction" type="button" title="Refaire (⇧⌘Z)" disabled>↷ Refaire</button>
					<button class="topbar__action topbar__action--secondary" id="startTour" type="button">Guide</button>
					<button class="topbar__action topbar__action--secondary" id="saveProject" type="button">Sauver</button>
					<label class="topbar__action topbar__action--secondary file-action">
						Charger
						<input id="loadProject" type="file" accept="application/json" />
					</label>
					<label class="topbar__action topbar__action--secondary guide-toggle">
						<input id="toggleGuides" type="checkbox" checked />
						Repères
					</label>
					<button class="topbar__action" id="exportPng" type="button">↓ PNG</button>
					<button class="topbar__action topbar__action--primary" id="exportPdf" type="button">↓ PDF impression</button>
				</div>
				<button class="topbar__menu-toggle" id="topbarMenu" type="button" aria-label="Menu" aria-expanded="false">
					<span></span><span></span><span></span>
				</button>
			</header>
			<div class="mobile-backdrop" id="mobileBackdrop" aria-hidden="true"></div>

			<aside class="rail rail--left" aria-label="Outils de jaquette">
				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Thème</span></div>
					<div class="themes">
						<button class="theme" data-theme="neon" data-active="true" type="button">
							<span class="theme__preview theme__preview--neon"></span>
							<span class="theme__label">NÉON</span>
						</button>
						<button class="theme" data-theme="rental" type="button">
							<span class="theme__preview theme__preview--rental"></span>
							<span class="theme__label">VIDÉOCLUB</span>
						</button>
						<button class="theme" data-theme="scifi" type="button">
							<span class="theme__preview theme__preview--scifi"></span>
							<span class="theme__label">SCI-FI</span>
						</button>
						<button class="theme" data-theme="horror" type="button">
							<span class="theme__preview theme__preview--horror"></span>
							<span class="theme__label">HORREUR</span>
						</button>
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Mise en page</span></div>
					<div class="layouts">
						<button class="layout" data-layout="classic" data-active="true" type="button">
							<span class="layout__preview layout__preview--classic"></span>
							<span class="layout__name">Classique</span>
						</button>
						<button class="layout" data-layout="bigtype" type="button">
							<span class="layout__preview layout__preview--bigtype"></span>
							<span class="layout__name">Gros titre</span>
						</button>
						<button class="layout" data-layout="poster" type="button">
							<span class="layout__preview layout__preview--poster"></span>
							<span class="layout__name">Affiche</span>
						</button>
						<button class="layout" data-layout="split" type="button">
							<span class="layout__preview layout__preview--split"></span>
							<span class="layout__name">Split</span>
						</button>
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Affiche</span></div>
					<button class="btn btn--neon upload-button" id="imageUploadButton" type="button">
						↥ Importer une image
					</button>
					<input class="file-input-hidden" id="imageUpload" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple />
					<div class="stack-row">
						<button class="btn btn--ghost" id="addText" type="button">+ Ajouter du texte</button>
					</div>
					<div class="tool-grid">
						<button class="btn btn--ghost" id="addTitle" type="button">+ Titre</button>
						<button class="btn btn--ghost" id="addBox" type="button">+ Bloc</button>
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Logos audio / vidéo</span></div>
					<div class="asset-tray asset-tray--compact" id="assetTray" aria-label="Logos audio/vidéo"></div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Classification</span></div>
					<div class="ratings-tray" id="ratingsTray" aria-label="Classifications">
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Étiquette</span></div>
					<small class="asset-count" id="assetCount"></small>
				</div>
			</aside>

			<main class="stage-shell" aria-label="Zone de création">
				<div class="stage__topbar">
					<button class="stage__rail-toggle stage__rail-toggle--left" id="toggleToolsRail" type="button" aria-label="Outils" aria-pressed="false">
						<span class="stage__rail-icon" aria-hidden="true">▤</span>
						<span class="stage__rail-text">Outils</span>
					</button>
					<div class="stage__history" aria-label="Historique">
						<button id="undoActionStage" type="button" title="Annuler (⌘Z)" disabled>↶</button>
						<button id="redoActionStage" type="button" title="Refaire (⇧⌘Z)" disabled>↷</button>
					</div>
					<button class="stage__tour-button" id="startTourStage" type="button" title="Guide rapide">?</button>
					<a
						class="stage__contest-link"
						id="contestLinkStage"
						href="https://boskop.org/appel-a-jaquettes-vhs-2026/"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Concours</span>
						<strong>Déposer</strong>
					</a>
					<div class="segment" role="group" aria-label="Zone cible">
						<button class="active" data-zone="front" type="button">Recto</button>
						<button data-zone="back" type="button">Verso</button>
						<button data-zone="spine" type="button">Tranche</button>
					</div>
					<div class="stage__hint">Cliquez un élément · glissez les coins pour redimensionner · double-clic pour éditer le texte</div>
					<button class="stage__rail-toggle stage__rail-toggle--right" id="toggleInspectorRail" type="button" aria-label="Calques" aria-pressed="false">
						<span class="stage__rail-icon" aria-hidden="true">⚙</span>
						<span class="stage__rail-text">Calques</span>
					</button>
				</div>
				<div class="stage-scroller" id="stageScroller">
					<div class="canvas-stage" id="dropStage">
						<canvas id="coverCanvas" aria-label="Prévisualisation de la jaquette VHS"></canvas>
						<div class="selection-toolbar" id="selectionToolbar" hidden>
							<button class="selection-toolbar__button text-controls" id="quickAlign" type="button" title="Alignement">≡</button>
							<label class="selection-toolbar__swatch color-controls" title="Couleur">
								<input id="quickColor" type="color" />
							</label>
							<button class="selection-toolbar__button image-controls" id="quickFit" type="button" title="Remplir / tout voir">⛶</button>
							<span class="selection-toolbar__divider"></span>
							<button class="selection-toolbar__button" id="quickBackward" type="button" title="Reculer">▼</button>
							<button class="selection-toolbar__button" id="quickForward" type="button" title="Avancer">▲</button>
							<button class="selection-toolbar__button" id="quickDuplicate" type="button" title="Dupliquer">⎘</button>
							<button class="selection-toolbar__button selection-toolbar__button--danger" id="quickDelete" type="button" title="Supprimer">✕</button>
						</div>
						<button class="canvas-delete" id="canvasDelete" type="button" aria-label="Supprimer l'élément" hidden>
							<span class="canvas-delete__icon" aria-hidden="true">✕</span>
							<span class="canvas-delete__confirm">Confirmer ?</span>
						</button>
					</div>
				</div>
				<div class="stage__zoom">
					<button id="fitZoom" type="button" title="Ajuster à l'écran">⤢ Ajuster</button>
				</div>
				<div class="statusbar" id="statusbar">
					<span>Sélectionne un élément : déplacer au doigt/souris, poignées pour redimensionner, pastille jaune pour tourner.</span>
					<span>258 x 194 mm · verso 114 mm · tranche 30 mm · recto 114 mm</span>
				</div>
			</main>

			<aside class="rail rail--right" aria-label="Inspecteur">
				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Inspecteur</span></div>
					<div class="selected-row">
						<span>Calque</span>
						<strong id="selectedLabel">aucun</strong>
					</div>
				</div>

				<div class="section inspector" id="inspector">
					<div class="inspector-primary-note">
						Les réglages rapides apparaissent au-dessus de l'élément sélectionné.
					</div>
					<div class="field">
						<label class="label" for="textContent">Contenu</label>
						<textarea class="textarea" id="textContent" rows="4"></textarea>
					</div>
					<div class="field">
						<label class="label" for="fontFamily">Police</label>
						<select class="input" id="fontFamily">
							<optgroup label="Kit BosKop / local">
								<option value="SF Movie Poster Condensed, Impact, sans-serif">SF Movie Poster Condensed</option>
								<option value="SF Movie Poster, Impact, sans-serif">SF Movie Poster</option>
								<option value="Bee Two, Georgia, serif">Bee Two</option>
							</optgroup>
							<optgroup label="Titres VHS / SF">
								<option value="Michroma, Eurostile, sans-serif">Michroma</option>
								<option value="Orbitron, Eurostile, sans-serif">Orbitron</option>
								<option value="Audiowide, Eurostile, sans-serif">Audiowide</option>
								<option value="Bungee Shade, Impact, sans-serif">Bungee Shade</option>
								<option value="Bungee, Impact, sans-serif">Bungee</option>
								<option value="Monoton, Impact, sans-serif">Monoton</option>
								<option value="Creepster, Georgia, serif">Creepster</option>
								<option value="Anton, Impact, sans-serif">Anton</option>
							</optgroup>
							<optgroup label="Textes / crédits">
								<option value="VT323, Courier New, monospace">VT323</option>
								<option value="Roboto Condensed, Arial Narrow, sans-serif">Roboto Condensed</option>
								<option value="Oswald, Arial Narrow, sans-serif">Oswald</option>
								<option value="Special Elite, Courier New, monospace">Special Elite</option>
								<option value="Courier Prime, Courier New, monospace">Courier Prime</option>
								<option value="Georgia, serif">Georgia</option>
								<option value="Arial, sans-serif">Arial</option>
							</optgroup>
						</select>
					</div>
					<div class="slider-row">
						<label for="fontSize">Taille</label>
						<input id="fontSize" type="range" min="2" max="34" step="0.5" />
					</div>
					<div class="split">
						<div class="field">
							<label class="label" for="fillColor">Couleur</label>
							<input id="fillColor" type="color" />
						</div>
						<div class="field">
							<label class="label" for="opacity">Opacité</label>
							<input id="opacity" type="range" min="0.1" max="1" step="0.05" />
						</div>
					</div>
					<div class="slider-row">
						<label for="rotation">Rotation</label>
						<input id="rotation" type="range" min="-180" max="180" step="1" />
					</div>
					<div class="split">
						<div class="field">
							<label class="label" for="textAlign">Alignement</label>
							<select class="input" id="textAlign">
								<option value="left">Gauche</option>
								<option value="center">Centre</option>
								<option value="right">Droite</option>
							</select>
						</div>
						<div class="field image-controls">
							<label class="label" for="imageFit">Image</label>
							<select class="input" id="imageFit">
								<option value="contain">Tout voir</option>
								<option value="cover">Remplir</option>
							</select>
						</div>
					</div>
					<button class="btn btn--ghost image-controls file-action" id="replaceImage" type="button">
						↥ Remplacer l'image
					</button>
					<input class="file-input-hidden" id="replaceImageInput" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" />
					<details class="advanced-controls">
						<summary>Réglages avancés</summary>
						<div class="position-grid">
							<label>X <input id="posX" type="number" step="1" /></label>
							<label>Y <input id="posY" type="number" step="1" /></label>
							<label>L <input id="posW" type="number" step="1" /></label>
							<label>H <input id="posH" type="number" step="1" /></label>
						</div>
						<div class="layer-actions">
							<button class="btn" id="bringForward" type="button">▲ Monter</button>
							<button class="btn" id="sendBackward" type="button">▼ Descendre</button>
							<button class="btn" id="duplicateLayer" type="button">⎘ Dupliquer</button>
							<button class="btn btn--danger" id="deleteLayer" type="button">✕ Supprimer</button>
						</div>
					</details>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Aide</span></div>
					<ul class="help-list">
						<li><b>Cliquer</b> un élément pour le sélectionner</li>
						<li><b>Double-cliquer</b> un texte pour le modifier</li>
						<li>Glisser pour <b>déplacer</b>, coins pour <b>redimensionner</b></li>
						<li>Pastille jaune au-dessus pour <b>tourner</b></li>
						<li><b>⌘D</b> dupliquer · <b>⌫</b> supprimer</li>
					</ul>
				</div>
			</aside>
			<div class="tour-overlay" id="tourOverlay" hidden>
				<div class="tour-spotlight" id="tourSpotlight"></div>
				<section class="tour-card" id="tourCard" role="dialog" aria-labelledby="tourTitle" aria-describedby="tourBody">
					<div class="tour-card__meta" id="tourMeta"></div>
					<h2 id="tourTitle"></h2>
					<p id="tourBody"></p>
					<div class="tour-card__actions">
						<button class="tour-card__button tour-card__button--ghost" id="tourSkip" type="button">Fermer</button>
						<button class="tour-card__button tour-card__button--ghost" id="tourPrev" type="button">Retour</button>
						<button class="tour-card__button" id="tourNext" type="button">Suivant</button>
					</div>
				</section>
			</div>
			<div class="ui-tooltip" id="uiTooltip" role="tooltip" hidden></div>
		</div>
	</body>
</html>

<script>
	import { jsPDF } from "jspdf";

	const COVER = { w: 258, h: 194 };
	const ZONES = {
