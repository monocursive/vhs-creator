---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>VHS Studio - Jaquette imprimable</title>
	</head>
	<body>
		<div class="app">
			<header class="topbar">
				<div class="brand" aria-label="VHS Studio">
					<span class="brand__logo">VHS STUDIO</span>
					<span class="brand__sub">REC ●</span>
				</div>
				<div class="topbar__festival">
					<small>Concours 2026</small>
					<strong>CONTRE-FICTIONS · BOSKOP · LES INTERGALACTIQUES</strong>
				</div>
				<div class="topbar__spacer"></div>
				<button class="topbar__action topbar__action--secondary" id="saveProject" type="button">Sauver</button>
				<label class="topbar__action topbar__action--secondary file-action">
					Charger
					<input id="loadProject" type="file" accept="application/json" />
				</label>
				<label class="topbar__action topbar__action--secondary guide-toggle">
					<input id="toggleGuides" type="checkbox" checked />
					Repères
				</label>
				<button class="topbar__action" id="exportPng" type="button">↓ PNG</button>
				<button class="topbar__action topbar__action--primary" id="exportPdf" type="button">↓ PDF impression</button>
			</header>

			<aside class="rail rail--left" aria-label="Outils de jaquette">
				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Thème</span></div>
					<div class="themes">
						<button class="theme" data-theme="neon" data-active="true" type="button">
							<span class="theme__preview theme__preview--neon"></span>
							<span class="theme__label">NÉON</span>
						</button>
						<button class="theme" data-theme="rental" type="button">
							<span class="theme__preview theme__preview--rental"></span>
							<span class="theme__label">VIDÉOCLUB</span>
						</button>
						<button class="theme" data-theme="scifi" type="button">
							<span class="theme__preview theme__preview--scifi"></span>
							<span class="theme__label">SCI-FI</span>
						</button>
						<button class="theme" data-theme="horror" type="button">
							<span class="theme__preview theme__preview--horror"></span>
							<span class="theme__label">HORREUR</span>
						</button>
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Mise en page</span></div>
					<div class="layouts">
						<button class="layout" data-layout="classic" data-active="true" type="button">
							<span class="layout__preview layout__preview--classic"></span>
							<span class="layout__name">Classique</span>
						</button>
						<button class="layout" data-layout="bigtype" type="button">
							<span class="layout__preview layout__preview--bigtype"></span>
							<span class="layout__name">Gros titre</span>
						</button>
						<button class="layout" data-layout="poster" type="button">
							<span class="layout__preview layout__preview--poster"></span>
							<span class="layout__name">Affiche</span>
						</button>
						<button class="layout" data-layout="split" type="button">
							<span class="layout__preview layout__preview--split"></span>
							<span class="layout__name">Split</span>
						</button>
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Affiche</span></div>
					<label class="btn btn--neon upload-button">
						↥ Importer une image
						<input id="imageUpload" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" multiple />
					</label>
					<div class="stack-row">
						<button class="btn btn--ghost" id="addText" type="button">+ Ajouter du texte</button>
					</div>
					<div class="tool-grid">
						<button class="btn btn--ghost" id="addTitle" type="button">+ Titre</button>
						<button class="btn btn--ghost" id="addBox" type="button">+ Bloc</button>
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Logos audio / vidéo</span></div>
					<div class="asset-tray asset-tray--compact" id="assetTray" aria-label="Logos audio/vidéo"></div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Classification</span></div>
					<div class="ratings-tray" id="ratingsTray" aria-label="Classifications">
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Étiquette</span></div>
					<small class="asset-count" id="assetCount"></small>
				</div>
			</aside>

			<main class="stage-shell" aria-label="Zone de création">
				<div class="stage__topbar">
					<div class="segment" role="group" aria-label="Zone cible">
						<button class="active" data-zone="front" type="button">Recto</button>
						<button data-zone="back" type="button">Verso</button>
						<button data-zone="spine" type="button">Tranche</button>
					</div>
					<div class="stage__hint">Cliquez un élément · glissez les coins pour redimensionner · double-clic pour éditer le texte</div>
				</div>
				<div class="stage-scroller" id="stageScroller">
					<div class="canvas-stage" id="dropStage">
						<canvas id="coverCanvas" aria-label="Prévisualisation de la jaquette VHS"></canvas>
					</div>
				</div>
				<div class="stage__zoom">
					<button id="fitZoom" type="button" title="Ajuster à l'écran">⤢ Ajuster</button>
				</div>
				<div class="statusbar" id="statusbar">
					<span>Sélectionne un élément : déplacer au doigt/souris, poignées pour redimensionner, pastille jaune pour tourner.</span>
					<span>258 x 194 mm · verso 114 mm · tranche 30 mm · recto 114 mm</span>
				</div>
			</main>

			<aside class="rail rail--right" aria-label="Inspecteur">
				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Inspecteur</span></div>
					<div class="selected-row">
						<span>Calque</span>
						<strong id="selectedLabel">aucun</strong>
					</div>
				</div>

				<div class="section inspector" id="inspector">
					<div class="field">
						<label class="label" for="textContent">Contenu</label>
						<textarea class="textarea" id="textContent" rows="4"></textarea>
					</div>
					<div class="field">
						<label class="label" for="fontFamily">Police</label>
						<select class="input" id="fontFamily">
							<optgroup label="Kit BosKop / local">
								<option value="SF Movie Poster Condensed, Impact, sans-serif">SF Movie Poster Condensed</option>
								<option value="SF Movie Poster, Impact, sans-serif">SF Movie Poster</option>
								<option value="Bee Two, Georgia, serif">Bee Two</option>
							</optgroup>
							<optgroup label="Titres VHS / SF">
								<option value="Michroma, Eurostile, sans-serif">Michroma</option>
								<option value="Orbitron, Eurostile, sans-serif">Orbitron</option>
								<option value="Audiowide, Eurostile, sans-serif">Audiowide</option>
								<option value="Bungee Shade, Impact, sans-serif">Bungee Shade</option>
								<option value="Bungee, Impact, sans-serif">Bungee</option>
								<option value="Monoton, Impact, sans-serif">Monoton</option>
								<option value="Creepster, Georgia, serif">Creepster</option>
								<option value="Anton, Impact, sans-serif">Anton</option>
							</optgroup>
							<optgroup label="Textes / crédits">
								<option value="VT323, Courier New, monospace">VT323</option>
								<option value="Roboto Condensed, Arial Narrow, sans-serif">Roboto Condensed</option>
								<option value="Oswald, Arial Narrow, sans-serif">Oswald</option>
								<option value="Special Elite, Courier New, monospace">Special Elite</option>
								<option value="Courier Prime, Courier New, monospace">Courier Prime</option>
								<option value="Georgia, serif">Georgia</option>
								<option value="Arial, sans-serif">Arial</option>
							</optgroup>
						</select>
					</div>
					<div class="slider-row">
						<label for="fontSize">Taille</label>
						<input id="fontSize" type="range" min="2" max="34" step="0.5" />
					</div>
					<div class="split">
						<div class="field">
							<label class="label" for="fillColor">Couleur</label>
							<input id="fillColor" type="color" />
						</div>
						<div class="field">
							<label class="label" for="opacity">Opacité</label>
							<input id="opacity" type="range" min="0.1" max="1" step="0.05" />
						</div>
					</div>
					<div class="slider-row">
						<label for="rotation">Rotation</label>
						<input id="rotation" type="range" min="-180" max="180" step="1" />
					</div>
					<div class="split">
						<div class="field">
							<label class="label" for="textAlign">Alignement</label>
							<select class="input" id="textAlign">
								<option value="left">Gauche</option>
								<option value="center">Centre</option>
								<option value="right">Droite</option>
							</select>
						</div>
						<div class="field image-controls">
							<label class="label" for="imageFit">Image</label>
							<select class="input" id="imageFit">
								<option value="contain">Tout voir</option>
								<option value="cover">Remplir</option>
							</select>
						</div>
					</div>
					<button class="btn btn--ghost image-controls" id="replaceImage" type="button">↥ Remplacer l'image</button>
					<div class="position-grid">
						<label>X <input id="posX" type="number" step="1" /></label>
						<label>Y <input id="posY" type="number" step="1" /></label>
						<label>L <input id="posW" type="number" step="1" /></label>
						<label>H <input id="posH" type="number" step="1" /></label>
					</div>
					<input id="replaceImageInput" type="file" accept="image/jpeg,image/png,.jpg,.jpeg,.png" hidden />
					<div class="layer-actions">
						<button class="btn" id="bringForward" type="button">▲ Monter</button>
						<button class="btn" id="sendBackward" type="button">▼ Descendre</button>
						<button class="btn" id="duplicateLayer" type="button">⎘ Dupliquer</button>
						<button class="btn btn--danger" id="deleteLayer" type="button">✕ Supprimer</button>
					</div>
				</div>

				<div class="section">
					<div class="section__head"><span class="section__dot"></span><span class="section__title">Aide</span></div>
					<ul class="help-list">
						<li><b>Cliquer</b> un élément pour le sélectionner</li>
						<li><b>Double-cliquer</b> un texte pour le modifier</li>
						<li>Glisser pour <b>déplacer</b>, coins pour <b>redimensionner</b></li>
						<li>Pastille jaune au-dessus pour <b>tourner</b></li>
						<li><b>⌘D</b> dupliquer · <b>⌫</b> supprimer</li>
					</ul>
				</div>
			</aside>
		</div>
	</body>
</html>

<script>
	import { jsPDF } from "jspdf";

	const COVER = { w: 258, h: 194 };
	const ZONES = {
		back: { x: 0, y: 0, w: 114, h: 194 },
		spine: { x: 114, y: 0, w: 30, h: 194 },
		front: { x: 144, y: 0, w: 114, h: 194 },
	};
	const A4 = { w: 297, h: 210 };
	const PRINT_SCALE = 300 / 25.4;
	const EXPORT_W = Math.round(COVER.w * PRINT_SCALE);
	const EXPORT_H = Math.round(COVER.h * PRINT_SCALE);

	const assets = [
		{ label: "VHS", kind: "av", src: "/VHS%20LOGO/vhs-2-logo-png-transparent.png" },
		{ label: "VHS old", kind: "av", src: "/VHS%20LOGO/VHS%20old%20style%20%20-%20transparent.png" },
		{ label: "VHS noir", kind: "av", src: "/VHS%20LOGO/VHS%20LOGO%20noir%20-%20transparent.png" },
		{ label: "SECAM", kind: "av", src: "/VHS%20LOGO/Logo%20VHS%20SECAM%20-%20transparent.png" },
		{ label: "Dolby", kind: "av", src: "/Logo%20AUDIO/Dolby_Surround_Logo-font-transparent.png" },
		{ label: "Dolby long", kind: "av", src: "/Logo%20AUDIO/dolby_surround_stereo_logo__1985_2001__by_ulises21998_dgrr85n-fullview.png" },
		{ label: "Hi-Fi", kind: "av", src: "/Logo%20AUDIO/Logo%20HIFI%20-%20transparent.png" },
		{ label: "THX", kind: "av", src: "/Logo%20AUDIO/THX_fond-transparent.png" },
		{ label: "CinemaScope", kind: "av", src: "/Logo%20Cinemascope/cinemascope-logo-png_transparentpng.png" },
		{ label: "Tous publics", kind: "rating", src: "/Logos%20Interdictions%20Ages/Tous%20publics.png" },
		{ label: "-12", kind: "rating", src: "/Logos%20Interdictions%20Ages/Interdit-12ans.png" },
		{ label: "-16", kind: "rating", src: "/Logos%20Interdictions%20Ages/Interdit-16ans.png" },
		{ label: "Accord parental", kind: "rating", src: "/Logos%20Interdictions%20Ages/Accord%20Parental.png" },
		{ label: "Interdit location", kind: "rating", src: "/Logos%20Interdictions%20Ages/Interdit%20a%CC%80%20la%20location.png" },
	];

	const THEMES = {
		neon: {
			back: "#16052d",
			spine: "#b71776",
			front: "#4a0a6e",
			accent: "#1bf0ff",
			secondary: "#ff2dd4",
			title: "#fffbe9",
			body: "#ffeacc",
			shadow: "#ff2dd4",
			titleFont: "Audiowide, SF Movie Poster Condensed, Impact, sans-serif",
			bodyFont: "VT323, Courier New, monospace",
		},
		rental: {
			back: "#f4e3b6",
			spine: "#d23218",
			front: "#e6c98a",
			accent: "#d23218",
			secondary: "#0e5740",
			title: "#1a0a00",
			body: "#2a1a0a",
			shadow: "#fff4d6",
			titleFont: "Bungee Shade, SF Movie Poster Condensed, Impact, sans-serif",
			bodyFont: "Courier Prime, Courier New, monospace",
		},
		scifi: {
			back: "#0a1238",
			spine: "#5e1a78",
			front: "#2c1a6e",
			accent: "#ffd84a",
			secondary: "#7adfff",
			title: "#fff4d6",
			body: "#d8e2f6",
			shadow: "#ff7a3a",
			titleFont: "Monoton, SF Movie Poster, Impact, sans-serif",
			bodyFont: "VT323, Courier New, monospace",
		},
		horror: {
			back: "#1c0506",
			spine: "#5a0a05",
			front: "#0a0102",
			accent: "#e8c860",
			secondary: "#c8141a",
			title: "#ff1a18",
			body: "#e8d4a8",
			shadow: "#000000",
			titleFont: "Creepster, Bungee Shade, Impact, sans-serif",
			bodyFont: "Special Elite, Courier New, monospace",
		},
	};

	let activeTheme = "neon";
	let activeLayout = "classic";

	const canvas = document.querySelector("#coverCanvas");
	const ctx = canvas.getContext("2d");
	const stage = document.querySelector("#dropStage");
	const stageScroller = document.querySelector("#stageScroller");
	const assetTray = document.querySelector("#assetTray");
	const ratingsTray = document.querySelector("#ratingsTray");
	const statusbar = document.querySelector("#statusbar");
	const selectedLabel = document.querySelector("#selectedLabel");
	const inspector = document.querySelector("#inspector");
	const assetCount = document.querySelector("#assetCount");
	const saveProject = document.querySelector("#saveProject");
	const loadProject = document.querySelector("#loadProject");
	const exportPng = document.querySelector("#exportPng");
	const exportPdf = document.querySelector("#exportPdf");
	const addTitle = document.querySelector("#addTitle");
	const addTextButton = document.querySelector("#addText");
	const addBox = document.querySelector("#addBox");
	const imageUpload = document.querySelector("#imageUpload");
	const toggleGuides = document.querySelector("#toggleGuides");
	const fitZoom = document.querySelector("#fitZoom");
	const textContent = document.querySelector("#textContent");
	const fontFamily = document.querySelector("#fontFamily");
	const fontSize = document.querySelector("#fontSize");
	const fillColor = document.querySelector("#fillColor");
	const opacity = document.querySelector("#opacity");
	const rotation = document.querySelector("#rotation");
	const textAlign = document.querySelector("#textAlign");
	const imageFit = document.querySelector("#imageFit");
	const replaceImage = document.querySelector("#replaceImage");
	const replaceImageInput = document.querySelector("#replaceImageInput");
	const posX = document.querySelector("#posX");
	const posY = document.querySelector("#posY");
	const posW = document.querySelector("#posW");
	const posH = document.querySelector("#posH");
	const bringForward = document.querySelector("#bringForward");
	const sendBackward = document.querySelector("#sendBackward");
	const duplicateLayer = document.querySelector("#duplicateLayer");
	const deleteLayer = document.querySelector("#deleteLayer");

	let activeZone = "front";
	let selectedId = null;
	let pointerMode = null;
	let dragState = null;
	let showGuides = true;
	let raf = 0;
	let currentScale = 1;
	const imageCache = new Map();

	const project = {
		name: "contre-fictions-vhs",
		background: "#16052d",
		objects: [
			rect("Fond verso", 0, 0, 114, 194, "#16052d", true),
			rect("Fond tranche", 114, 0, 30, 194, "#b71776", true),
			rect("Fond recto", 144, 0, 114, 194, "#4a0a6e", true),
			rect("Halo soleil", 165, 34, 72, 58, "#ff7a3a"),
			rect("Horizon VHS", 144, 132, 114, 62, "#120327"),
			rect("Liseré magenta", 151, 10, 100, 4, "#ff2dd4"),
			rect("Bande cyan", 151, 16, 100, 2.5, "#1bf0ff"),
			text("Titre", "TITRE\nDU FILM", 150, 132, 102, 30, 18, "#fffbe9", "center", "Audiowide, SF Movie Poster Condensed, Impact, sans-serif"),
			text("Accroche", "UNE NUIT, TOUT BASCULE", 154, 165, 94, 7, 4, "#1bf0ff", "center", "VT323, Courier New, monospace"),
			text("Réalisateur", "UN FILM DE  PRÉNOM NOM", 154, 179, 94, 6, 3.3, "#ffeacc", "center", "SF Movie Poster Condensed, Impact, sans-serif"),
			text("Synopsis titre", "SYNOPSIS", 8, 13, 94, 12, 7, "#1bf0ff", "left", "Audiowide, SF Movie Poster Condensed, Impact, sans-serif"),
			text("Verso synopsis", "Dans une métropole rongée par les pluies acides, une archiviste découvre une cassette qui ne devrait pas exister. Plus elle la regarde, plus la réalité se brouille.\n\nLe festival CONTRE-FICTIONS vous invite à imaginer le film qui se cache sur cette bande magnétique.", 8, 29, 94, 55, 4.3, "#ffeacc", "left", "VT323, Courier New, monospace"),
			rect("Photogramme A", 8, 91, 44, 30, "#2c1a6e"),
			rect("Photogramme B", 62, 91, 44, 30, "#ff2dd4"),
			text("Critique", "\"Le choc magnétique de l'année.\" - VHS 3000", 8, 131, 98, 14, 4.5, "#ffd84a", "center", "Georgia, serif"),
			text("Crédits", "CONTRE-FICTIONS · BOSKOP · 2026 · COULEUR · STEREO · DUREE 96 MIN · © LES INTERGALACTIQUES", 8, 171, 98, 12, 3, "#ffffff", "center", "SF Movie Poster Condensed, Impact, sans-serif"),
			text("Tranche", "TITRE DU FILM", 54, 89.5, 150, 15, 8.5, "#ffe357", "center", "Audiowide, SF Movie Poster Condensed, Impact, sans-serif", -90),
		],
	};

	function makeId() {
		return `layer-${Math.random().toString(36).slice(2, 9)}`;
	}

	function rect(name, x, y, w, h, fill, locked = false) {
		return { id: makeId(), type: "rect", name, x, y, w, h, fill, stroke: "transparent", opacity: 1, rotation: 0, locked };
	}

	function text(name, content, x, y, w, h, fontSize, fill, align, fontFamily, rotation = 0) {
		return { id: makeId(), type: "text", name, content, x, y, w, h, fontSize, fill, align, fontFamily, opacity: 1, rotation, locked: false, shadow: "" };
	}

	function image(name, src, x, y, w, h) {
		void loadImage(src);
		return { id: makeId(), type: "image", name, src, x, y, w, h, opacity: 1, rotation: 0, fit: "contain", locked: false };
	}

	function zoneCenter(zoneName, size) {
		const zone = ZONES[zoneName];
		return {
			x: zone.x + (zone.w - size.w) / 2,
			y: zone.y + (zone.h - size.h) / 2,
		};
	}

	function scheduleRender() {
		if (raf) return;
		raf = requestAnimationFrame(() => {
			raf = 0;
			render();
		});
	}

	function setupCanvasSize() {
		const box = stage.getBoundingClientRect();
		const maxWidth = Math.max(320, box.width);
		const cssW = Math.min(maxWidth, 1180);
		const cssH = cssW * (COVER.h / COVER.w);
		const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
		canvas.style.width = `${cssW}px`;
		canvas.style.height = `${cssH}px`;
		canvas.width = Math.round(cssW * dpr);
		canvas.height = Math.round(cssH * dpr);
		currentScale = canvas.width / COVER.w;
		render();
	}

	function render(targetCanvas = canvas, opts = {}) {
		const targetCtx = targetCanvas.getContext("2d");
		const scale = targetCanvas.width / COVER.w;
		targetCtx.clearRect(0, 0, targetCanvas.width, targetCanvas.height);
		drawBackdrop(targetCtx, scale);
		for (const object of project.objects) drawObject(targetCtx, object, scale);
		if (opts.guides !== false && showGuides) drawGuides(targetCtx, scale);
		if (targetCanvas === canvas && selectedId) drawSelection(targetCtx, getSelected(), scale);
	}

	function drawBackdrop(targetCtx, scale) {
		targetCtx.save();
		targetCtx.fillStyle = project.background;
		targetCtx.fillRect(0, 0, COVER.w * scale, COVER.h * scale);
		targetCtx.globalAlpha = 0.16;
		for (let y = 0; y < COVER.h; y += 2.2) {
			targetCtx.fillStyle = y % 4.4 < 2.2 ? "#ffffff" : "#000000";
			targetCtx.fillRect(0, y * scale, COVER.w * scale, 0.45 * scale);
		}
		targetCtx.restore();
	}

	function drawObject(targetCtx, object, scale) {
		targetCtx.save();
		targetCtx.globalAlpha = object.opacity ?? 1;
		const cx = (object.x + object.w / 2) * scale;
		const cy = (object.y + object.h / 2) * scale;
		targetCtx.translate(cx, cy);
		targetCtx.rotate(((object.rotation || 0) * Math.PI) / 180);
		targetCtx.translate((-object.w * scale) / 2, (-object.h * scale) / 2);

		if (object.type === "rect") {
			targetCtx.fillStyle = object.fill;
			targetCtx.fillRect(0, 0, object.w * scale, object.h * scale);
			if (object.stroke && object.stroke !== "transparent") {
				targetCtx.strokeStyle = object.stroke;
				targetCtx.lineWidth = Math.max(1, 0.4 * scale);
				targetCtx.strokeRect(0, 0, object.w * scale, object.h * scale);
			}
		}

		if (object.type === "image") {
			const img = imageCache.get(object.src);
			if (img?.complete) {
				drawFittedImage(targetCtx, img, object.w * scale, object.h * scale, object.fit || "contain");
			} else {
				targetCtx.fillStyle = "#111";
				targetCtx.fillRect(0, 0, object.w * scale, object.h * scale);
				targetCtx.strokeStyle = "#ff2dd4";
				targetCtx.strokeRect(0, 0, object.w * scale, object.h * scale);
			}
		}

		if (object.type === "text") {
			drawText(targetCtx, object, scale);
		}
		targetCtx.restore();
	}

	function drawFittedImage(targetCtx, img, w, h, fit) {
		const imageRatio = img.naturalWidth / img.naturalHeight;
		const boxRatio = w / h;
		let dw = w;
		let dh = h;
		let dx = 0;
		let dy = 0;
		if (fit === "cover" ? imageRatio > boxRatio : imageRatio < boxRatio) {
			dh = fit === "cover" ? h : w / imageRatio;
			dw = fit === "cover" ? h * imageRatio : w;
			dx = (w - dw) / 2;
			dy = (h - dh) / 2;
		} else {
			dw = fit === "cover" ? w : h * imageRatio;
			dh = fit === "cover" ? w / imageRatio : h;
			dx = (w - dw) / 2;
			dy = (h - dh) / 2;
		}
		targetCtx.drawImage(img, dx, dy, dw, dh);
	}

	function drawText(targetCtx, object, scale) {
		const size = object.fontSize * scale;
		const lineHeight = size * 1.08;
		targetCtx.fillStyle = object.fill;
		targetCtx.font = `900 ${size}px ${object.fontFamily}`;
		targetCtx.textAlign = object.align || "left";
		targetCtx.textBaseline = "top";
		if (object.shadow) {
			targetCtx.shadowColor = object.shadow;
			targetCtx.shadowBlur = 2.2 * scale;
			targetCtx.shadowOffsetX = 1.2 * scale;
			targetCtx.shadowOffsetY = 1.2 * scale;
		}
		const maxWidth = object.w * scale;
		const x = object.align === "center" ? maxWidth / 2 : object.align === "right" ? maxWidth : 0;
		const lines = wrapText(targetCtx, object.content || "", maxWidth);
		lines.slice(0, Math.max(1, Math.ceil((object.h * scale) / lineHeight))).forEach((line, index) => {
			targetCtx.fillText(line, x, index * lineHeight);
		});
	}

	function wrapText(targetCtx, textValue, maxWidth) {
		const hardLines = String(textValue).split("\n");
		const lines = [];
		for (const hardLine of hardLines) {
			const words = hardLine.split(/\s+/).filter(Boolean);
			if (!words.length) {
				lines.push("");
				continue;
			}
			let line = "";
			for (const word of words) {
				const next = line ? `${line} ${word}` : word;
				if (targetCtx.measureText(next).width <= maxWidth || !line) {
					line = next;
				} else {
					lines.push(line);
					line = word;
				}
			}
			lines.push(line);
		}
		return lines;
	}

	function drawGuides(targetCtx, scale) {
		targetCtx.save();
		targetCtx.strokeStyle = "#ff3434";
		targetCtx.lineWidth = Math.max(1, 0.35 * scale);
		targetCtx.strokeRect(0.4 * scale, 0.4 * scale, (COVER.w - 0.8) * scale, (COVER.h - 0.8) * scale);
		targetCtx.setLineDash([4 * scale, 2.5 * scale]);
		targetCtx.strokeStyle = "rgba(255,255,255,0.62)";
		targetCtx.beginPath();
		targetCtx.moveTo(ZONES.spine.x * scale, 0);
		targetCtx.lineTo(ZONES.spine.x * scale, COVER.h * scale);
		targetCtx.moveTo((ZONES.spine.x + ZONES.spine.w) * scale, 0);
		targetCtx.lineTo((ZONES.spine.x + ZONES.spine.w) * scale, COVER.h * scale);
		targetCtx.stroke();
		targetCtx.setLineDash([]);
		targetCtx.fillStyle = "rgba(255,255,255,0.84)";
		targetCtx.font = `700 ${Math.max(9, 2.8 * scale)}px Arial`;
		targetCtx.fillText("VERSO", 3 * scale, 5 * scale);
		targetCtx.fillText("TRANCHE", 116 * scale, 5 * scale);
		targetCtx.fillText("RECTO", 147 * scale, 5 * scale);
		targetCtx.restore();
	}

	function drawSelection(targetCtx, object, scale) {
		if (!object) return;
		const cx = (object.x + object.w / 2) * scale;
		const cy = (object.y + object.h / 2) * scale;
		targetCtx.save();
		targetCtx.translate(cx, cy);
		targetCtx.rotate(degToRad(object.rotation || 0));
		targetCtx.translate((-object.w * scale) / 2, (-object.h * scale) / 2);
		targetCtx.strokeStyle = "#fff365";
		targetCtx.lineWidth = Math.max(1.5, 0.45 * scale);
		targetCtx.setLineDash([5, 4]);
		targetCtx.strokeRect(0, 0, object.w * scale, object.h * scale);
		targetCtx.setLineDash([]);
		targetCtx.restore();

		const handles = getHandles(object);
		const top = handles.find((handle) => handle.name === "n");
		const rotate = handles.find((handle) => handle.name === "rotate");
		targetCtx.save();
		targetCtx.lineWidth = 2;
		targetCtx.strokeStyle = "#fff365";
		targetCtx.beginPath();
		targetCtx.moveTo(top.x * scale, top.y * scale);
		targetCtx.lineTo(rotate.x * scale, rotate.y * scale);
		targetCtx.stroke();
		for (const handle of handles) {
			targetCtx.fillStyle = handle.type === "rotate" ? "#fff365" : "#0c0614";
			targetCtx.strokeStyle = handle.type === "rotate" ? "#160b22" : "#21f7ff";
			targetCtx.lineWidth = 2;
			targetCtx.beginPath();
			if (handle.type === "rotate") {
				targetCtx.arc(handle.x * scale, handle.y * scale, 7, 0, Math.PI * 2);
			} else {
				targetCtx.rect(handle.x * scale - 6, handle.y * scale - 6, 12, 12);
			}
			targetCtx.fill();
			targetCtx.stroke();
		}
		targetCtx.restore();
	}

	function getHandles(object) {
		const locals = [
			{ name: "nw", x: 0, y: 0, type: "resize", cursor: "nwse-resize" },
			{ name: "n", x: object.w / 2, y: 0, type: "resize", cursor: "ns-resize" },
			{ name: "ne", x: object.w, y: 0, type: "resize", cursor: "nesw-resize" },
			{ name: "e", x: object.w, y: object.h / 2, type: "resize", cursor: "ew-resize" },
			{ name: "se", x: object.w, y: object.h, type: "resize", cursor: "nwse-resize" },
			{ name: "s", x: object.w / 2, y: object.h, type: "resize", cursor: "ns-resize" },
			{ name: "sw", x: 0, y: object.h, type: "resize", cursor: "nesw-resize" },
			{ name: "w", x: 0, y: object.h / 2, type: "resize", cursor: "ew-resize" },
			{ name: "rotate", x: object.w / 2, y: -14, type: "rotate", cursor: "grab" },
		];
		return locals.map((handle) => ({ ...handle, ...localToWorld(object, handle) }));
	}

	function loadImage(src) {
		if (imageCache.has(src)) return Promise.resolve(imageCache.get(src));
		return new Promise((resolve, reject) => {
			const img = new Image();
			img.onload = () => {
				imageCache.set(src, img);
				scheduleRender();
				resolve(img);
			};
			img.onerror = reject;
			img.src = src;
			imageCache.set(src, img);
		});
	}

	function canvasPoint(event) {
		const rect = canvas.getBoundingClientRect();
		return {
			x: ((event.clientX - rect.left) / rect.width) * COVER.w,
			y: ((event.clientY - rect.top) / rect.height) * COVER.h,
		};
	}

	function degToRad(degrees) {
		return (degrees * Math.PI) / 180;
	}

	function radToDeg(radians) {
		return (radians * 180) / Math.PI;
	}

	function normalizeAngle(degrees) {
		let angle = ((degrees + 180) % 360) - 180;
		if (angle < -180) angle += 360;
		return angle;
	}

	function rotatePoint(point, angle) {
		const cos = Math.cos(angle);
		const sin = Math.sin(angle);
		return {
			x: point.x * cos - point.y * sin,
			y: point.x * sin + point.y * cos,
		};
	}

	function objectCenter(object) {
		return { x: object.x + object.w / 2, y: object.y + object.h / 2 };
	}

	function localToWorld(object, local) {
		const center = objectCenter(object);
		const rotated = rotatePoint({ x: local.x - object.w / 2, y: local.y - object.h / 2 }, degToRad(object.rotation || 0));
		return { x: center.x + rotated.x, y: center.y + rotated.y };
	}

	function worldToLocal(point, object) {
		const center = objectCenter(object);
		const rotated = rotatePoint({ x: point.x - center.x, y: point.y - center.y }, -degToRad(object.rotation || 0));
		return { x: rotated.x + object.w / 2, y: rotated.y + object.h / 2 };
	}

	function hitTest(point) {
		for (let i = project.objects.length - 1; i >= 0; i--) {
			const object = project.objects[i];
			if (object.locked) continue;
			const local = worldToLocal(point, object);
			if (local.x >= 0 && local.x <= object.w && local.y >= 0 && local.y <= object.h) return object;
		}
		return null;
	}

	function hitHandle(point) {
		const selected = getSelected();
		if (!selected) return null;
		const threshold = 13 / currentScale;
		return getHandles(selected).find((handle) => Math.hypot(point.x - handle.x, point.y - handle.y) < threshold);
	}

	function getSelected() {
		return project.objects.find((object) => object.id === selectedId) || null;
	}

	function selectObject(id) {
		selectedId = id;
		updateInspector();
		scheduleRender();
	}

	function updateInspector() {
		const object = getSelected();
		selectedLabel.textContent = object ? object.name : "aucun";
		inspector.classList.toggle("empty", !object);
		const textControls = [textContent, fontFamily, fontSize, textAlign];
		textControls.forEach((control) => {
			control.disabled = !object || object.type !== "text";
		});
		imageFit.disabled = !object || object.type !== "image";
		replaceImage.disabled = !object || object.type !== "image";
		if (!object) return;
		textContent.value = object.type === "text" ? object.content : "";
		fontFamily.value = object.fontFamily || "Arial, sans-serif";
		fontSize.value = object.fontSize || 8;
		fillColor.value = object.fill || "#ffffff";
		opacity.value = object.opacity ?? 1;
		rotation.value = object.rotation || 0;
		textAlign.value = object.align || "left";
		imageFit.value = object.fit || "contain";
		posX.value = Math.round(object.x);
		posY.value = Math.round(object.y);
		posW.value = Math.round(object.w);
		posH.value = Math.round(object.h);
	}

	function updateSelected(mutator) {
		const object = getSelected();
		if (!object) return;
		mutator(object);
		updateInspector();
		scheduleRender();
	}

	function addObject(object) {
		project.objects.push(object);
		selectObject(object.id);
		setStatus(`${object.name} ajouté.`);
	}

	function addTextLayer(kind) {
		const t = THEMES[activeTheme];
		const size = kind === "title" ? { w: 88, h: 26 } : { w: 86, h: 36 };
		const pos = zoneCenter(activeZone, size);
		const layer = text(
			kind === "title" ? "Titre" : "Texte",
			kind === "title" ? "TITRE DU FILM" : "Synopsis, casting, durée, copyright...",
			pos.x,
			pos.y,
			size.w,
			size.h,
			kind === "title" ? 13 : 5,
			kind === "title" ? t.title : t.body,
			kind === "title" ? "center" : "left",
			kind === "title" ? t.titleFont : t.bodyFont,
		);
		layer.shadow = kind === "title" ? t.shadow : "";
		addObject(layer);
	}

	function addTextAt(point) {
		const t = THEMES[activeTheme];
		const size = { w: 70, h: 26 };
		const layer = text(
			"Texte libre",
			"NOUVEAU TEXTE",
			clamp(point.x - size.w / 2, 0, COVER.w - size.w),
			clamp(point.y - size.h / 2, 0, COVER.h - size.h),
			size.w,
			size.h,
			7,
			t.title,
			"center",
			t.titleFont,
		);
		layer.shadow = t.shadow;
		addObject(layer);
		textContent.focus();
		textContent.select();
	}

	function addRect() {
		const t = THEMES[activeTheme];
		const size = activeZone === "spine" ? { w: 18, h: 52 } : { w: 54, h: 34 };
		const pos = zoneCenter(activeZone, size);
		addObject(rect("Bloc couleur", pos.x, pos.y, size.w, size.h, t.secondary));
	}

	function addAsset(src, name = "Image", point = null) {
		const size = activeZone === "spine" ? { w: 18, h: 18 } : { w: 28, h: 16 };
		const pos = point ? { x: point.x - size.w / 2, y: point.y - size.h / 2 } : zoneCenter(activeZone, size);
		addObject(image(name, src, clamp(pos.x, 0, COVER.w - size.w), clamp(pos.y, 0, COVER.h - size.h), size.w, size.h));
	}

	function addImportedImage(src, name = "Image importée", point = null) {
		const zoneName = activeZone;
		const zone = ZONES[zoneName];
		const size = zoneName === "spine" ? { w: 24, h: 32 } : { w: Math.min(86, zone.w - 12), h: 62 };
		const pos = point ? { x: point.x - size.w / 2, y: point.y - size.h / 2 } : zoneCenter(activeZone, size);
		const object = image(name, src, clamp(pos.x, 0, COVER.w - size.w), clamp(pos.y, 0, COVER.h - size.h), size.w, size.h);
		addObject(object);
		loadImage(src)
			.then((img) => {
				const ratio = img.naturalWidth / img.naturalHeight;
				const maxW = zoneName === "spine" ? 24 : Math.min(92, zone.w - 10);
				const maxH = zoneName === "spine" ? 130 : Math.min(130, zone.h - 16);
				const byWidth = { w: maxW, h: maxW / ratio };
				const next = byWidth.h <= maxH ? byWidth : { w: maxH * ratio, h: maxH };
				object.w = next.w;
				object.h = next.h;
				object.x = clamp(point ? point.x - object.w / 2 : zone.x + (zone.w - object.w) / 2, 0, COVER.w - object.w);
				object.y = clamp(point ? point.y - object.h / 2 : zone.y + (zone.h - object.h) / 2, 0, COVER.h - object.h);
				updateInspector();
				scheduleRender();
			})
			.catch(() => setStatus("Image impossible à charger."));
	}

	function frontObjects() {
		return project.objects.filter((object) => object.x >= ZONES.front.x && !object.locked);
	}

	function rebuildFront(layoutKey) {
		const t = THEMES[activeTheme];
		const previous = frontObjects();
		const oldTitle = previous.find((object) => object.type === "text" && object.fontSize >= 10)?.content || "TITRE\nDU FILM";
		const oldTagline = previous.find((object) => object.type === "text" && object.fontSize < 7)?.content || "UNE NUIT, TOUT BASCULE";
		project.objects = project.objects.filter((object, index) => index < 3 || object.x < ZONES.front.x);

		const created = [];
		const add = (object) => {
			created.push(object);
			return object;
		};
		if (layoutKey === "classic") {
			add(rect("Affiche placeholder", 163, 28, 76, 100, t.secondary));
			add(text("Titre", oldTitle, 150, 132, 102, 30, 18, t.title, "center", t.titleFont));
			add(text("Accroche", oldTagline, 154, 165, 94, 7, 4, t.accent, "center", t.bodyFont));
			add(text("Réalisateur", "UN FILM DE  PRÉNOM NOM", 154, 179, 94, 6, 3.3, t.body, "center", "SF Movie Poster Condensed, Impact, sans-serif"));
		}
		if (layoutKey === "bigtype") {
			add(rect("Image plein recto", 150, 10, 102, 172, t.secondary));
			add(rect("Bande titre", 144, 118, 114, 64, "#000000"));
			add(text("Titre", oldTitle, 149, 124, 104, 44, 25, t.title, "center", t.titleFont));
			add(text("Accroche", oldTagline, 154, 173, 94, 7, 4, t.accent, "center", t.bodyFont));
		}
		if (layoutKey === "poster") {
			add(rect("Image plein cadre", 144, 0, 114, 194, t.secondary));
			add(text("Titre", oldTitle, 150, 10, 102, 32, 15, t.title, "center", t.titleFont));
			add(text("Accroche", oldTagline, 154, 176, 94, 7, 4, t.accent, "center", t.bodyFont));
		}
		if (layoutKey === "split") {
			add(rect("Bande split", 144, 0, 114, 88, t.secondary));
			add(rect("Image split", 159, 13, 84, 68, project.background));
			add(text("Titre", oldTitle, 150, 96, 102, 54, 22, t.title, "center", t.titleFont));
			add(text("Accroche", oldTagline, 154, 158, 94, 8, 4, t.accent, "center", t.bodyFont));
			add(text("Réalisateur", "UN FILM DE  PRÉNOM NOM", 154, 178, 94, 6, 3.3, t.body, "center", "SF Movie Poster Condensed, Impact, sans-serif"));
		}
		created.forEach((object) => {
			if (object.type === "text" && object.fontSize >= 10) object.shadow = t.shadow;
			if (object.name?.includes("Bande titre")) object.opacity = 0.58;
		});
		project.objects.push(...created);
		selectObject(created.find((object) => object.type === "text")?.id || null);
	}

	function applyTheme(theme) {
		const [back, spine, front] = project.objects.slice(0, 3);
		const t = THEMES[theme] || THEMES.neon;
		activeTheme = theme;
		back.fill = t.back;
		spine.fill = t.spine;
		front.fill = t.front;
		project.background = t.back;
		project.objects.forEach((object) => {
			if (object.locked) return;
			if (object.type === "text") {
				const isTitle = object.fontSize >= 10 || object.name === "Tranche";
				object.fill = isTitle ? t.title : object.fontSize <= 4.5 ? t.accent : t.body;
				object.fontFamily = isTitle ? t.titleFont : t.bodyFont;
				object.shadow = isTitle ? t.shadow : "";
			}
			if (object.type === "rect" && object.name?.includes("Liseré")) object.fill = t.secondary;
			if (object.type === "rect" && object.name?.includes("Bande cyan")) object.fill = t.accent;
		});
		document.querySelectorAll("[data-theme]").forEach((button) => {
			button.dataset.active = String(button.dataset.theme === theme);
		});
		setStatus(`Ambiance ${theme}.`);
		scheduleRender();
	}

	function applyLayout(layoutKey) {
		activeLayout = layoutKey;
		rebuildFront(layoutKey);
		document.querySelectorAll("[data-layout]").forEach((button) => {
			button.dataset.active = String(button.dataset.layout === layoutKey);
		});
		setStatus(`Mise en page ${layoutKey}.`);
		scheduleRender();
	}

	function clamp(value, min, max) {
		return Math.min(Math.max(value, min), max);
	}

	function setStatus(message) {
		statusbar.firstElementChild.textContent = message;
	}

	function downloadBlob(blob, filename) {
		const url = URL.createObjectURL(blob);
		const link = document.createElement("a");
		link.href = url;
		link.download = filename;
		link.click();
		URL.revokeObjectURL(url);
	}

	async function renderExportCanvas() {
		await Promise.all(project.objects.filter((object) => object.type === "image").map((object) => loadImage(object.src).catch(() => null)));
		const exportCanvas = document.createElement("canvas");
		exportCanvas.width = EXPORT_W;
		exportCanvas.height = EXPORT_H;
		render(exportCanvas, { guides: false });
		return exportCanvas;
	}

	async function exportPngFile() {
		setStatus("Export PNG en cours...");
		const exportCanvas = await renderExportCanvas();
		exportCanvas.toBlob((blob) => {
			if (blob) downloadBlob(blob, "jaquette-vhs-258x194mm-300dpi.png");
			setStatus("PNG 300 dpi exporté.");
		}, "image/png");
	}

	async function exportPdfFile() {
		setStatus("Préparation du PDF A4...");
		const exportCanvas = await renderExportCanvas();
		const pdf = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4", compress: true });
		const x = (A4.w - COVER.w) / 2;
		const y = (A4.h - COVER.h) / 2;
		pdf.setFillColor(255, 255, 255);
		pdf.rect(0, 0, A4.w, A4.h, "F");
		pdf.addImage(exportCanvas.toDataURL("image/png"), "PNG", x, y, COVER.w, COVER.h);
		drawPdfGuides(pdf, x, y);
		pdf.save("jaquette-vhs-a4-print.pdf");
		setStatus("PDF A4 exporté.");
	}

	function drawPdfGuides(pdf, x, y) {
		pdf.setDrawColor(255, 52, 52);
		pdf.setLineWidth(0.25);
		pdf.rect(x, y, COVER.w, COVER.h);
		pdf.setDrawColor(0, 0, 0);
		pdf.setLineWidth(0.18);
		const mark = 6;
		const corners = [
			[x, y, -1, -1],
			[x + COVER.w, y, 1, -1],
			[x, y + COVER.h, -1, 1],
			[x + COVER.w, y + COVER.h, 1, 1],
		];
		for (const [cx, cy, sx, sy] of corners) {
			pdf.line(cx, cy + sy * 2, cx, cy + sy * mark);
			pdf.line(cx + sx * 2, cy, cx + sx * mark, cy);
		}
		pdf.setDrawColor(40, 40, 40);
		pdf.setLineDashPattern([2, 1.5], 0);
		pdf.line(x + 114, y, x + 114, y + COVER.h);
		pdf.line(x + 144, y, x + 144, y + COVER.h);
		pdf.setLineDashPattern([], 0);
	}

	function wireAssets() {
		const av = assets.filter((asset) => asset.kind !== "rating");
		const ratings = assets.filter((asset) => asset.kind === "rating");
		assetTray.innerHTML = av
			.map(
				(asset) => `
					<button class="asset" type="button" draggable="true" data-src="${asset.src}" title="${asset.label}">
						<img src="${asset.src}" alt="" loading="lazy" />
						<span>${asset.label}</span>
					</button>
				`,
			)
			.join("");
		ratingsTray.innerHTML = ratings
			.map(
				(asset) => `
					<button class="rating" type="button" draggable="true" data-src="${asset.src}" title="${asset.label}" aria-label="${asset.label}">
						<img src="${asset.src}" alt="${asset.label}" loading="lazy" />
					</button>
				`,
			)
			.join("");
		assetCount.textContent = `${assets.length} logos disponibles`;
		const wireButton = (button) => {
			button.addEventListener("click", () => addAsset(button.dataset.src, button.title));
			button.addEventListener("dragstart", (event) => {
				event.dataTransfer.setData("text/plain", button.dataset.src);
			});
		};
		assetTray.querySelectorAll(".asset").forEach(wireButton);
		ratingsTray.querySelectorAll(".rating").forEach(wireButton);
	}

	function wireEvents() {
		document.querySelectorAll(".segment button").forEach((button) => {
			button.addEventListener("click", () => {
				document.querySelector(".segment .active").classList.remove("active");
				button.classList.add("active");
				activeZone = button.dataset.zone;
			});
		});

		document.querySelectorAll("[data-theme]").forEach((button) => button.addEventListener("click", () => applyTheme(button.dataset.theme)));
		document.querySelectorAll("[data-layout]").forEach((button) => button.addEventListener("click", () => applyLayout(button.dataset.layout)));
		addTitle.addEventListener("click", () => addTextLayer("title"));
		addTextButton.addEventListener("click", () => addTextLayer("body"));
		addBox.addEventListener("click", addRect);
		imageUpload.addEventListener("change", (event) => handleFiles(event.target.files));
		toggleGuides.addEventListener("change", () => {
			showGuides = toggleGuides.checked;
			scheduleRender();
		});
		fitZoom.addEventListener("click", () => {
			const target = canvas;
			const wrap = stageScroller;
			if (!target || !wrap) return;
			const left = Math.max(0, (target.offsetWidth - wrap.clientWidth) / 2);
			const top = Math.max(0, (target.offsetHeight - wrap.clientHeight) / 2);
			wrap.scrollTo({ left, top, behavior: "smooth" });
		});
		exportPng.addEventListener("click", exportPngFile);
		exportPdf.addEventListener("click", exportPdfFile);
		saveProject.addEventListener("click", saveProjectFile);
		loadProject.addEventListener("change", loadProjectFile);

		for (const control of [textContent, fontFamily, fontSize, fillColor, opacity, rotation, textAlign, imageFit, posX, posY, posW, posH]) {
			control.addEventListener("input", applyInspectorChange);
		}
		replaceImage.addEventListener("click", () => replaceImageInput.click());
		replaceImageInput.addEventListener("change", replaceSelectedImage);
		bringForward.addEventListener("click", () => moveLayer(1));
		sendBackward.addEventListener("click", () => moveLayer(-1));
		duplicateLayer.addEventListener("click", duplicateSelected);
		deleteLayer.addEventListener("click", deleteSelected);

		canvas.addEventListener("pointerdown", onPointerDown);
		canvas.addEventListener("pointermove", onPointerMove);
		canvas.addEventListener("pointerup", onPointerUp);
		canvas.addEventListener("pointercancel", onPointerUp);
		canvas.addEventListener("dblclick", (event) => {
			const point = canvasPoint(event);
			const object = hitTest(point);
			if (object?.type === "text") {
				selectObject(object.id);
				textContent.focus();
				textContent.select();
				return;
			}
			addTextAt(point);
		});
		stage.addEventListener("dragover", (event) => event.preventDefault());
		stage.addEventListener("drop", onDrop);
		window.addEventListener("resize", setupCanvasSize);
		window.addEventListener("keydown", onKeyDown);
	}

	function onPointerDown(event) {
		canvas.setPointerCapture(event.pointerId);
		const point = canvasPoint(event);
		const handle = hitHandle(point);
		if (handle) {
			const object = getSelected();
			const center = objectCenter(object);
			pointerMode = handle.type;
			dragState = {
				id: selectedId,
				handle: handle.name,
				start: point,
				startAngle: Math.atan2(point.y - center.y, point.x - center.x),
				original: { ...object },
			};
			return;
		}
		const object = hitTest(point);
		selectObject(object?.id || null);
		if (object) {
			pointerMode = "move";
			dragState = { id: object.id, dx: point.x - object.x, dy: point.y - object.y };
		}
	}

	function onPointerMove(event) {
		const point = canvasPoint(event);
		if (!pointerMode || !dragState) {
			const handle = hitHandle(point);
			canvas.style.cursor = handle ? handle.cursor : hitTest(point) ? "move" : "crosshair";
			return;
		}
		const object = getSelected();
		if (!object) return;
		if (pointerMode === "move") {
			object.x = clamp(point.x - dragState.dx, -object.w + 4, COVER.w - 4);
			object.y = clamp(point.y - dragState.dy, -object.h + 4, COVER.h - 4);
		}
		if (pointerMode === "resize") resizeObject(object, point, dragState);
		if (pointerMode === "rotate") rotateObject(object, point, dragState, event.shiftKey);
		updateInspector();
		scheduleRender();
	}

	function onPointerUp(event) {
		try {
			canvas.releasePointerCapture(event.pointerId);
		} catch (_) {
			// Pointer capture can already be released by the browser on touch cancel.
		}
		pointerMode = null;
		dragState = null;
	}

	function resizeObject(object, point, state) {
		const original = state.original;
		const min = 5;
		const local = worldToLocal(point, original);
		const fixed = fixedAnchorForHandle(state.handle, original);
		let left = 0;
		let right = original.w;
		let top = 0;
		let bottom = original.h;

		if (state.handle.includes("w")) left = Math.min(local.x, original.w - min);
		if (state.handle.includes("e")) right = Math.max(local.x, min);
		if (state.handle.includes("n")) top = Math.min(local.y, original.h - min);
		if (state.handle.includes("s")) bottom = Math.max(local.y, min);

		const nextW = Math.max(min, right - left);
		const nextH = Math.max(min, bottom - top);
		const fixedWorld = localToWorld(original, fixed.originalLocal);
		const fixedOffset = rotatePoint(
			{
				x: fixed.nextLocal(nextW, nextH).x - nextW / 2,
				y: fixed.nextLocal(nextW, nextH).y - nextH / 2,
			},
			degToRad(original.rotation || 0),
		);
		const nextCenter = { x: fixedWorld.x - fixedOffset.x, y: fixedWorld.y - fixedOffset.y };

		object.x = nextCenter.x - nextW / 2;
		object.y = nextCenter.y - nextH / 2;
		object.w = nextW;
		object.h = nextH;
		object.rotation = original.rotation;
	}

	function fixedAnchorForHandle(handle, object) {
		if (handle === "n") return { originalLocal: { x: object.w / 2, y: object.h }, nextLocal: (w, h) => ({ x: w / 2, y: h }) };
		if (handle === "s") return { originalLocal: { x: object.w / 2, y: 0 }, nextLocal: (w) => ({ x: w / 2, y: 0 }) };
		if (handle === "e") return { originalLocal: { x: 0, y: object.h / 2 }, nextLocal: (_w, h) => ({ x: 0, y: h / 2 }) };
		if (handle === "w") return { originalLocal: { x: object.w, y: object.h / 2 }, nextLocal: (w, h) => ({ x: w, y: h / 2 }) };
		if (handle === "ne") return { originalLocal: { x: 0, y: object.h }, nextLocal: (_w, h) => ({ x: 0, y: h }) };
		if (handle === "nw") return { originalLocal: { x: object.w, y: object.h }, nextLocal: (w, h) => ({ x: w, y: h }) };
		if (handle === "se") return { originalLocal: { x: 0, y: 0 }, nextLocal: () => ({ x: 0, y: 0 }) };
		return { originalLocal: { x: object.w, y: 0 }, nextLocal: (w) => ({ x: w, y: 0 }) };
	}

	function rotateObject(object, point, state, snap) {
		const original = state.original;
		const center = objectCenter(original);
		const currentAngle = Math.atan2(point.y - center.y, point.x - center.x);
		let next = normalizeAngle((original.rotation || 0) + radToDeg(currentAngle - state.startAngle));
		if (snap) next = Math.round(next / 15) * 15;
		object.rotation = next;
	}

	function onDrop(event) {
		event.preventDefault();
		const point = canvasPoint(event);
		if (event.dataTransfer.files?.length) {
			handleFiles(event.dataTransfer.files, point);
			return;
		}
		const src = event.dataTransfer.getData("text/plain");
		if (src) addAsset(src, "Logo", point);
	}

	function handleFiles(files, point = null) {
		const list = Array.from(files || []);
		const accepted = list.filter((file) => file.type === "image/jpeg" || file.type === "image/png" || /\.(jpe?g|png)$/i.test(file.name));
		const rejected = list.length - accepted.length;
		if (rejected > 0) {
			setStatus(rejected === list.length ? "Format non supporté : utilise JPEG ou PNG." : `${rejected} fichier(s) ignoré(s) (JPEG ou PNG seulement).`);
		}
		accepted.forEach((file) => {
			const reader = new FileReader();
			reader.onload = () => {
				addImportedImage(reader.result, file.name.replace(/\.[^.]+$/, ""), point);
				setStatus(`Image « ${file.name} » ajoutée.`);
			};
			reader.onerror = () => setStatus(`Impossible de lire « ${file.name} ».`);
			reader.readAsDataURL(file);
		});
	}

	function applyInspectorChange() {
		updateSelected((object) => {
			if (object.type === "text") {
				object.content = textContent.value;
				object.fontFamily = fontFamily.value;
				object.fontSize = Number(fontSize.value);
				object.align = textAlign.value;
			}
			if (object.type === "image") object.fit = imageFit.value;
			object.fill = fillColor.value;
			object.opacity = Number(opacity.value);
			object.rotation = Number(rotation.value);
			object.x = Number(posX.value);
			object.y = Number(posY.value);
			object.w = Math.max(2, Number(posW.value));
			object.h = Math.max(2, Number(posH.value));
		});
	}

	function replaceSelectedImage(event) {
		const object = getSelected();
		const file = event.target.files?.[0];
		if (!object || object.type !== "image" || !file) return;
		const reader = new FileReader();
		reader.onload = () => {
			object.src = reader.result;
			object.name = file.name.replace(/\.[^.]+$/, "");
			void loadImage(object.src);
			updateInspector();
			scheduleRender();
			setStatus("Image remplacée.");
		};
		reader.readAsDataURL(file);
		event.target.value = "";
	}

	function moveLayer(direction) {
		const index = project.objects.findIndex((object) => object.id === selectedId);
		const next = index + direction;
		if (index < 3 || next < 3 || next >= project.objects.length) return;
		const [object] = project.objects.splice(index, 1);
		project.objects.splice(next, 0, object);
		scheduleRender();
	}

	function duplicateSelected() {
		const object = getSelected();
		if (!object) return;
		const copy = structuredClone(object);
		copy.id = makeId();
		copy.name = `${object.name} copie`;
		copy.x += 5;
		copy.y += 5;
		copy.locked = false;
		project.objects.push(copy);
		selectObject(copy.id);
	}

	function deleteSelected() {
		const object = getSelected();
		if (!object || object.locked) return;
		project.objects = project.objects.filter((item) => item.id !== object.id);
		selectObject(null);
	}

	function onKeyDown(event) {
		if (["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement.tagName)) return;
		if (event.key === "Delete" || event.key === "Backspace") deleteSelected();
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "d") {
			event.preventDefault();
			duplicateSelected();
		}
	}

	function saveProjectFile() {
		const payload = JSON.stringify(project, null, 2);
		downloadBlob(new Blob([payload], { type: "application/json" }), "vhs-studio-project.json");
	}

	function loadProjectFile(event) {
		const file = event.target.files?.[0];
		if (!file) return;
		const reader = new FileReader();
		reader.onload = () => {
			try {
				const data = JSON.parse(String(reader.result));
				project.name = data.name || project.name;
				project.background = data.background || project.background;
				project.objects = Array.isArray(data.objects) ? data.objects : project.objects;
				project.objects.filter((object) => object.type === "image").forEach((object) => void loadImage(object.src));
				selectObject(null);
				setStatus("Projet chargé.");
				scheduleRender();
			} catch (_) {
				setStatus("Fichier projet illisible.");
			}
		};
		reader.readAsText(file);
	}

	wireAssets();
	wireEvents();
	project.objects.filter((object) => object.type === "image").forEach((object) => void loadImage(object.src));
	setupCanvasSize();
	updateInspector();
	document.fonts?.ready.then(() => scheduleRender());
</script>

